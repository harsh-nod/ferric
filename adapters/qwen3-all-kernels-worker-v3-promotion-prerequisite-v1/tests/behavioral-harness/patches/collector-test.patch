+#[test]
+fn ferric_all12_collector_accepts_exact_live_inputs_and_rejects_hostile_state() {
+    let worker_v3_fixture::PublishedWorkerV3Fixture {
+        directory,
+        producer,
+        attempt,
+        published,
+    } = worker_v3_fixture::published_ferric_all12_worker_v3_fixture();
+    let subject = published.compiler_execution_subject_v1().unwrap();
+    let envelope = WorkerV3LoadEnvelopeV2::from_published_hsaco_v1(
+        published,
+        carriage_for_subject(&subject, 0x61),
+    )
+    .unwrap();
+    let intent = envelope
+        .wire()
+        .replay()
+        .publication_intent_record()
+        .identity();
+    let readiness = envelope
+        .persist_durable_replay_custody_v2(&directory.0)
+        .unwrap();
+    retire_worker_v3_publication_intent_after_load_readiness_v1(
+        &directory.0,
+        &producer,
+        attempt,
+        intent,
+        readiness.receipt(),
+    )
+    .unwrap();
+    drop(envelope);
+    fs::set_permissions(&directory.0, fs::Permissions::from_mode(0o700)).unwrap();
+    let retained =
+        RetainedDurableDirectoryV1::admit_service_owned(File::open(&directory.0).unwrap().into())
+            .unwrap();
+    let recovered =
+        recover_worker_v3_load_envelope_from_retained_directory_v2(&retained, attempt).unwrap();
+    let material = collector_material(&recovered);
+    drop(recovered);
+
+    let prerequisite = collect_m1_all_kernels_promotion_prerequisite_v1(
+        &retained,
+        attempt,
+        &material.external(),
+    )
+    .unwrap();
+    assert!(!prerequisite.is_current());
+    assert!(!prerequisite.grants_publication_authority());
+    assert!(!prerequisite.grants_load_authority());
+    assert!(!prerequisite.grants_launch_authority());
+    assert!(prerequisite.requires_external_promotion_service());
+    let debug = format!("{prerequisite:?}");
+    assert!(debug.contains("holds_current_publication_lock: true"));
+    assert!(!debug.contains(&"73".repeat(32)));
+    let cooperative_lock = File::open(&directory.0).unwrap();
+    assert_eq!(
+        unsafe { libc::flock(cooperative_lock.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) },
+        -1,
+        "the live collector owner must retain the cooperative publication lock"
+    );
+    let handoff = prerequisite
+        .revalidate_and_seal_for_external_promotion_v1()
+        .unwrap();
+    assert!(!handoff.is_current());
+    assert!(!handoff.grants_publication_authority());
+    assert!(!handoff.grants_load_authority());
+    assert!(!handoff.grants_launch_authority());
+    assert_eq!(
+        unsafe { libc::flock(cooperative_lock.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) },
+        -1,
+        "the sealed external handoff must retain the cooperative publication lock"
+    );
+    drop(handoff);
+    assert_eq!(
+        unsafe { libc::flock(cooperative_lock.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) },
+        0,
+        "dropping the handoff must release its cooperative lock"
+    );
+    assert_eq!(unsafe { libc::flock(cooperative_lock.as_raw_fd(), libc::LOCK_UN) }, 0);
+
+    // This collector only correlates a caller challenge. Durable replay consumption belongs to
+    // the external promotion service, so the same valid material is accepted again after drop.
+    drop(
+        collect_m1_all_kernels_promotion_prerequisite_v1(
+            &retained,
+            attempt,
+            &material.external(),
+        )
+        .unwrap(),
+    );
+
+    let substituted_request = substituted_service_request(&material);
+    let substituted = M1AllKernelsPromotionExternalInputsV1::new(
+        material.receipt.encode_canonical(),
+        &material.trust_policy,
+        &substituted_request,
+        &material.compiler_policy,
+        material.challenge,
+        material.current_verification.canonical_bytes(),
+        material.current_attestation.canonical_bytes(),
+    )
+    .unwrap();
+    assert!(matches!(
+        collect_m1_all_kernels_promotion_prerequisite_v1(&retained, attempt, &substituted),
+        Err(M1AllKernelsPromotionPrerequisiteErrorV1::Binding(
+            M1AllKernelsPromotionBindingFieldV1::ProtectedServiceRequest
+        ))
+    ));
+
+    let recovered =
+        recover_worker_v3_load_envelope_from_retained_directory_v2(&retained, attempt).unwrap();
+    for field in [
+        M1AllKernelsPromotionBindingFieldV1::SourcePin,
+        M1AllKernelsPromotionBindingFieldV1::FinalizedHsacoSha256,
+        M1AllKernelsPromotionBindingFieldV1::FinalizedHsacoLength,
+        M1AllKernelsPromotionBindingFieldV1::CompilerSubject,
+        M1AllKernelsPromotionBindingFieldV1::CompilerCarriage,
+        M1AllKernelsPromotionBindingFieldV1::CompilerPolicy,
+        M1AllKernelsPromotionBindingFieldV1::CompilerIssuerJournal,
+        M1AllKernelsPromotionBindingFieldV1::CompilerOccurrence,
+        M1AllKernelsPromotionBindingFieldV1::CompilerReceipt,
