+
+    let (substituted_verification, _) =
+        current_records(recovered.wire().compiler_execution_receipt(), [0x74; 32]);
+    let wrong_verification = M1AllKernelsPromotionExternalInputsV1::new(
+        material.receipt.encode_canonical(),
+        &material.trust_policy,
+        &material.service_request,
