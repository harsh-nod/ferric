+struct CollectorMaterial {
+    trust_policy: M1AllKernelsProtectedVerifierTrustPolicyV1,
+    service_request: M1AllKernelsProtectedVerifierServiceRequestV1,
+    compiler_policy: CompilerExecutionIssuerPolicyV1,
+    receipt: M1AllKernelsProtectedVerifierReceiptV1,
+    current_verification: CompilerExecutionCurrentRecordVerificationV3,
+    current_attestation: CompilerExecutionCurrentRecordAttestationV3,
+    challenge: [u8; 32],
+}
+
+impl CollectorMaterial {
+    fn external(&self) -> M1AllKernelsPromotionExternalInputsV1<'_> {
+        M1AllKernelsPromotionExternalInputsV1::new(
+            self.receipt.encode_canonical(),
+            &self.trust_policy,
+            &self.service_request,
+            &self.compiler_policy,
+            self.challenge,
+            self.current_verification.canonical_bytes(),
+            self.current_attestation.canonical_bytes(),
+        )
+        .unwrap()
+    }
+}
+
+fn current_records(
+    carriage: &CompilerExecutionReceiptCarriageV1,
+    challenge: [u8; 32],
+) -> (
+    CompilerExecutionCurrentRecordVerificationV3,
+    CompilerExecutionCurrentRecordAttestationV3,
+) {
+    let signing_key = SigningKey::from_bytes(&[0x61; 32]);
+    let anchor_signing_key = SigningKey::from_bytes(&[0x62; 32]);
+    assert_eq!(carriage.policy().verifying_key(), signing_key.verifying_key().as_bytes());
+    assert_eq!(
+        carriage.policy().external_anchor_verifying_key(),
+        anchor_signing_key.verifying_key().as_bytes()
+    );
+    let transaction = CompilerExecutionExternalAnchorTransactionV1::new(
+        carriage.policy().clone(),
+        carriage.request().clone(),
+        carriage.publication().clone(),
+    )
+    .unwrap();
+    let anchor_key =
+        PinnedAnchorKeyV1::from_bytes(anchor_signing_key.verifying_key().to_bytes()).unwrap();
+    let pending = AnchoredStateV1::from_local_state(0, HashChainHeadV1::from_bytes([0; 32]))
+        .prepare(transaction.external_anchor_digest(), &anchor_key)
+        .unwrap()
+        .begin_advance(CallerNonceV1::from_bytes([0x67; 32]), &anchor_key)
+        .unwrap();
+    let unsigned =
+        UnsignedAnchorObservationV1::from_challenge(pending.challenge(), AnchorPositionV1::Proposed);
+    let signature = anchor_signing_key.sign(&unsigned.signing_bytes()).to_bytes();
+    let commit_receipt = AnchorTransitionReceiptV1::new(
+        pending.challenge().clone(),
+        &unsigned.attach_signature(signature),
+        &anchor_key,
+    )
+    .unwrap();
+    let currentness_challenge =
+        CompilerExecutionCurrentRecordVerificationV3::external_anchor_currentness_challenge(
+            carriage,
+            &commit_receipt,
+            challenge,
+        )
+        .unwrap();
+    let unsigned = UnsignedAnchorObservationV1::from_challenge(
+        &currentness_challenge,
+        AnchorPositionV1::Proposed,
+    );
+    let signature = anchor_signing_key.sign(&unsigned.signing_bytes()).to_bytes();
+    let currentness_receipt = AnchorTransitionReceiptV1::new(
+        currentness_challenge,
+        &unsigned.attach_signature(signature),
+        &anchor_key,
+    )
+    .unwrap();
+    let verification = CompilerExecutionCurrentRecordVerificationV3::new(
+        carriage,
+        commit_receipt,
+        currentness_receipt,
+        challenge,
+        [0x91; 32],
+        [0x92; 32],
+    )
+    .unwrap();
+    let attestation = CompilerExecutionCurrentRecordAttestationV3::issue(
+        carriage.policy(),
+        carriage,
+        verification.clone(),
+        challenge,
+        &signing_key,
+    )
+    .unwrap();
+    (verification, attestation)
+}
+
+fn hostile_identity(mut exact: [u8; 32]) -> [u8; 32] {
+    exact[0] ^= 1;
+    exact
+}
+
+fn binding_identity(
+    mutation: Option<M1AllKernelsPromotionBindingFieldV1>,
+    field: M1AllKernelsPromotionBindingFieldV1,
+    exact: [u8; 32],
+) -> [u8; 32] {
+    if mutation == Some(field) {
+        hostile_identity(exact)
+    } else {
+        exact
+    }
+}
+
+fn collector_material_with_binding_mutation(
+    recovered: &RecoveredWorkerV3LoadEnvelopeV2,
+    mutation: Option<M1AllKernelsPromotionBindingFieldV1>,
+) -> CollectorMaterial {
+    let challenge = [0x73; 32];
+    let carriage = recovered.wire().compiler_execution_receipt();
+    let (current_verification, current_attestation) = current_records(carriage, challenge);
+    let source_pin = extract_m1_aggregate_source_pin_v1(
+        recovered.canonical_evidence_view().exact_canonical_bytes(),
+    )
+    .unwrap()
+    .source_pin();
+    let source_pin = M1AllKernelsProtectedReceiptSourcePinV1::new(
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::SourcePin,
+            source_pin.compiler_module_sha256(),
+        ),
+        source_pin.compiler_module_length(),
+        source_pin.compiler_handoff_sha256(),
+        source_pin.compiler_handoff_length(),
+        source_pin.symbol_manifest_sha256(),
+        source_pin.symbol_manifest_length(),
+    )
+    .unwrap();
+    let artifact = recovered.exact_artifact_bytes();
+    let request_claims = M1AllKernelsProtectedReceiptRequestClaimsV1::new(
+        [0x31; 32],
+        [0x32; 32],
+        [0x33; 32],
+        [0x34; 32],
+        source_pin,
+        [0x35; 32],
+        [0x36; 32],
+        [0x37; 32],
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::FinalizedHsacoSha256,
+            Sha256::digest(artifact).into(),
+        ),
+        if mutation == Some(M1AllKernelsPromotionBindingFieldV1::FinalizedHsacoLength) {
+            artifact.len() as u64 + 1
+        } else {
+            artifact.len() as u64
+        },
+    )
+    .unwrap();
+    let subject = recovered
+        .wire()
+        .reconstructed_compiler_execution_subject_v1()
+        .unwrap();
+    let compiler_claims = M1AllKernelsProtectedReceiptCompilerClaimsV1::new(
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CompilerSubject,
+            *subject.identity().sha256(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CompilerCarriage,
+            *carriage.identity().as_bytes(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CompilerPolicy,
+            *carriage.policy().identity().as_bytes(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CompilerIssuerJournal,
+            carriage.publication().issuer_journal_identity(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CompilerOccurrence,
+            carriage.publication().compiler_occurrence_identity(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CompilerReceipt,
+            *carriage.publication().receipt_identity().as_bytes(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CompilerPublication,
+            *carriage.publication().identity().as_bytes(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CompilerAcknowledgment,
+            *carriage.acknowledgment().identity().as_bytes(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CompilerWorkerLedger,
+            carriage.acknowledgment().worker_ledger_record_identity(),
+        ),
+        if mutation == Some(M1AllKernelsPromotionBindingFieldV1::CompilerSequence) {
+            carriage.acknowledgment().sequence() + 1
+        } else {
+            carriage.acknowledgment().sequence()
+        },
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CompilerPriorRollbackAnchor,
+            carriage.publication().receipt().prior_rollback_anchor(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CompilerCurrentRollbackAnchor,
+            carriage.acknowledgment().current_rollback_anchor(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CurrentVerificationIdentity,
+            *current_verification.identity().as_bytes(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::CurrentAttestationIdentity,
+            *current_attestation.identity().as_bytes(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::ProtectedPolicyVerification,
+            current_verification.protected_policy_verification_identity(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::ProtectedWorkerLedgerVerification,
+            current_verification.protected_worker_ledger_verification_identity(),
+        ),
+        binding_identity(
+            mutation,
+            M1AllKernelsPromotionBindingFieldV1::ExternalRollbackVerification,
+            current_verification.external_rollback_verification_identity(),
+        ),
+    )
+    .unwrap();
+    let entries = core::array::from_fn(|index| {
+        let seed = index as u8;
+        M1AllKernelsProtectedReceiptEntryV1::new(
+            index as u16,
+            [0x40 + seed; 32],
+            [0x50 + seed; 32],
+            [0x60 + (seed % 3); 32],
+            [0x80 + seed; 32],
+            [0xa0 + seed; 32],
+            [0xc0 + seed; 32],
+            WorkerV3SafetyPropertiesV1::required(),
+        )
+        .unwrap()
+    });
+    let signing_key = SigningKey::from_bytes(&[0x21; 32]);
+    let trust_policy = M1AllKernelsProtectedVerifierTrustPolicyV1::new(
+        signing_key.verifying_key().to_bytes(),
+        [0xe1; 32],
+        [0xe2; 32],
+    )
+    .unwrap();
+    let unsigned = M1AllKernelsUnsignedProtectedVerifierReceiptV1::new(
+        trust_policy.identity(),
+        request_claims,
+        compiler_claims,
+        [0xe1; 32],
+        [0xe2; 32],
+        [0xe3; 32],
+        entries,
+    )
+    .unwrap();
+    let signature = signing_key.sign(&unsigned.signing_bytes()).to_bytes();
+    let receipt = unsigned.attach_signature(signature);
+    let service_entries = core::array::from_fn(|index| {
+        M1AllKernelsProtectedVerifierServiceEntryV1::from_receipt_entry(&receipt.entries()[index])
+    });
+    let service_request = M1AllKernelsProtectedVerifierServiceRequestV1::new(
+        trust_policy.identity(),
+        *receipt.request_claims(),
+        *receipt.compiler_claims(),
+        service_entries,
+    )
+    .unwrap();
+    CollectorMaterial {
+        trust_policy,
+        service_request,
+        compiler_policy: carriage.policy().clone(),
+        receipt,
+        current_verification,
+        current_attestation,
+        challenge,
+    }
+}
+
+fn collector_material(recovered: &RecoveredWorkerV3LoadEnvelopeV2) -> CollectorMaterial {
+    collector_material_with_binding_mutation(recovered, None)
+}
+
+fn substituted_service_request(
+    material: &CollectorMaterial,
+) -> M1AllKernelsProtectedVerifierServiceRequestV1 {
+    let receipt = &material.receipt;
+    let claims = receipt.request_claims();
+    let changed = M1AllKernelsProtectedReceiptRequestClaimsV1::new(
+        [0x39; 32],
+        claims.roster_identity(),
+        claims.host_lineage_identity(),
+        claims.finalizer_derivation_sha256(),
+        claims.source_pin(),
+        claims.capsule_sha256(),
+        claims.formal_memory_receipt_sha256(),
+        claims.proof_binding_receipt_sha256(),
+        claims.finalized_hsaco_sha256(),
+        claims.finalized_hsaco_length(),
+    )
+    .unwrap();
+    let entries = core::array::from_fn(|index| {
+        M1AllKernelsProtectedVerifierServiceEntryV1::from_receipt_entry(&receipt.entries()[index])
+    });
+    M1AllKernelsProtectedVerifierServiceRequestV1::new(
+        material.trust_policy.identity(),
+        changed,
+        *receipt.compiler_claims(),
+        entries,
+    )
+    .unwrap()
+}
