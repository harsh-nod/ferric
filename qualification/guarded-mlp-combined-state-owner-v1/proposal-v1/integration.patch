+                unsafe {
+                    LinuxGfx950MemoryBackend::observe_combined_mlp_state_v1(mapping, requested)
+                }
+                .is_err()
+            );
+            assert_eq!(observe(mapping), before);
+            assert!(tail_is_untouched(raw));
+        });
+    }
+}
