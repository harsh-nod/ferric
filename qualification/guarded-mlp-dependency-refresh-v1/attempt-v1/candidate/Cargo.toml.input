[package]
name = "ferric-qwen3-tp-guarded-mlp-segment-kernels-device-v1"
version = "0.1.0"
edition = "2024"
rust-version = "1.94"
publish = false

[workspace]

[features]
default = ["gfx950"]
gfx950 = []

[dependencies]
fe2o3-device = { git = "https://github.com/harsh-nod/fe2o3.git", rev = "5a500d63c29b78f8788356b20dfcbb5c41ec20c9", version = "=0.1.0" }

[target.'cfg(not(target_arch = "amdgpu"))'.dependencies]
fe2o3-host = { git = "https://github.com/harsh-nod/fe2o3.git", rev = "5a500d63c29b78f8788356b20dfcbb5c41ec20c9", version = "=0.1.0" }

[lib]
name = "ferric_qwen3_tp_guarded_mlp_segment_kernels_device_v1"
path = "src/lib.rs"
