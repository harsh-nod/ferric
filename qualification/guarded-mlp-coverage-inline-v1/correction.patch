+#[test]
+fn coverage_extremes_and_rejected_write_retirement_preserve_claim_state() {
+    assert_eq!((TASK_COUNT, STOP, WAVE_LANES), (258, 259, 64));
+    for (token, counts) in [
+        (0, Some((0, 0))),
+        (1, Some((64, 64))),
+        (2, Some((64, 0))),
+        (97, Some((64, 0))),
+        (98, Some((64, 0))),
+        (193, Some((64, 0))),
+        (194, Some((96, 96))),
+        (195, Some((64, 0))),
+        (258, Some((64, 0))),
+        (259, Some((0, 0))),
+        (260, None),
+        (u32::MAX, None),
+    ] {
+        for lane in [0, 1, 63, 64, usize::MAX] {
+            let expected = counts.and_then(|(leader, others)| match lane {
+                0 => Some(leader),
+                1..=63 => Some(others),
+                _ => None,
+            });
+            for written in [0, 1, 63, 64, 65, 95, 96, 97, usize::MAX] {
+                for valid in [false, true] {
+                    assert_eq!(
+                        complete_coverage(token, lane, written, valid),
+                        valid && expected == Some(written),
+                        "token={token} lane={lane} written={written} valid={valid}"
+                    );
+                }
+            }
+        }
+    }
+
+    // Failed coverage must retire a real claim without publishing completion.
+    let s = state();
+    let token = claim(&s, 3) + 1;
+    let before = snapshot(&s);
+    let mut result = observation();
+    let mut retired = false;
+    let all_valid = complete_coverage(token, 63, 63, true);
+    assert!(!all_valid);
+    finish_round_completion(&s, token, all_valid, &mut retired, &mut result);
+    let mut expected = before;
+    expected[ERRORS] |= INCOMPLETE_WRITES;
+    assert_eq!(snapshot(&s), expected);
+    assert_eq!(result.error, INCOMPLETE_WRITES);
+    assert_eq!(result.executed_tasks, 0);
+    assert_eq!(result.rounds, 0);
+    assert_eq!(result.empty_probes, 0);
+    assert!(retired);
+    assert!(!terminal_snapshot(&snapshot(&s)));
+    assert_eq!(begin_round_claim(&s, 0, 3, &mut retired, &mut result), STOP);
+    assert_eq!(snapshot(&s), expected);
+    for lane in 0..64 {
+        assert!(complete_coverage(STOP, lane, 0, true));
+    }
 }
 
