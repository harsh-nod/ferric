+    #[test]
+    fn inline_hint_profile_rejects_unversioned_injected_and_duplicate_selectors() {
+        let root = env::temp_dir();
+        for selector in [
+            "",
+            "optimized-inline-hint-16384",
+            "optimized-inline-hint-8192-v1",
+            "optimized-inline-hint-16384-v2",
+            "optimized-inline-hint-16384-v1 -Copt-level=0",
+            "-Zinline-mir-hint-threshold=16384",
+        ] {
+            let mut args = base_args(&root);
+            let delimiter = args.iter().position(|value| value == "--").unwrap();
+            args.splice(
+                delimiter..delimiter,
+                ["--mir-normalization".into(), selector.into()],
+            );
+            assert!(parse(&args, &root).is_err(), "accepted {selector:?}");
+        }
+        for second in [
+            "minimal-v1",
+            "optimized-inline-v1",
+            "optimized-inline-hint-16384-v1",
+        ] {
+            let mut args = base_args(&root);
+            let delimiter = args.iter().position(|value| value == "--").unwrap();
+            args.splice(
+                delimiter..delimiter,
+                [
+                    "--mir-normalization".into(),
+                    "optimized-inline-hint-16384-v1".into(),
+                    "--mir-normalization".into(),
+                    second.into(),
+                ],
+            );
+            assert!(parse(&args, &root).is_err(), "accepted duplicate {second}");
+        }
+        let mut missing = base_args(&root);
+        let delimiter = missing.iter().position(|value| value == "--").unwrap();
+        missing.insert(delimiter, "--mir-normalization".into());
+        assert!(parse(&missing, &root).is_err());
+        for injected in [
+            "--mir-normalization",
+            "--rustflags",
+            "--config",
+            "-Z",
+            "-C",
+            "--jobs",
+        ] {
+            let mut args = base_args(&root);
+            args.extend([injected.into(), "optimized-inline-hint-16384-v1".into()]);
+            assert!(
+                parse(&args, &root).is_err(),
+                "accepted Cargo override {injected}"
+            );
+        }
+        for name in [
+            "RUSTFLAGS",
+            "CARGO_ENCODED_RUSTFLAGS",
+            "CARGO_TARGET_AMDGCN_AMD_AMDHSA_RUSTFLAGS",
+            "CARGO_PROFILE_DEV_OPT_LEVEL",
+        ] {
+            assert!(conflicting_environment_name(OsStr::new(name)));
+        }
+    }
