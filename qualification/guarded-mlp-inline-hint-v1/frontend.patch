     #[test]
+    fn inline_hint_profile_preserves_defaults_and_exact_target_flags() {
+        let root = env::temp_dir();
+        for profile in [
+            ProductionAmdTargetProfileV1::Gfx942,
+            ProductionAmdTargetProfileV1::Gfx950,
+        ] {
+            for (selector, expected, inline, optimization, hint) in [
+                (None, MirNormalizationV1::Minimal, "no", "0", ""),
+                (
+                    Some("minimal-v1"),
+                    MirNormalizationV1::Minimal,
+                    "no",
+                    "0",
+                    "",
+                ),
+                (
+                    Some("optimized-inline-v1"),
+                    MirNormalizationV1::OptimizedInline,
+                    "yes",
+                    "3",
+                    "",
+                ),
+                (
+                    Some("optimized-inline-hint-16384-v1"),
+                    MirNormalizationV1::OptimizedInlineHint16384,
+                    "yes",
+                    "3",
+                    " -Zinline-mir-hint-threshold=16384",
+                ),
+            ] {
+                let mut args = base_args(&root);
+                let target = args.iter().position(|value| value == "--target").unwrap() + 1;
+                args[target] = profile.device_target().into();
+                if let Some(selector) = selector {
+                    let delimiter = args.iter().position(|value| value == "--").unwrap();
+                    args.splice(
+                        delimiter..delimiter,
+                        ["--mir-normalization".into(), selector.into()],
+                    );
+                }
+                let options = parse(&args, &root).unwrap();
+                assert_eq!(options.mir_normalization, expected);
+                assert_eq!(
+                    options.mir_normalization.name(),
+                    selector.unwrap_or("minimal-v1")
+                );
+                assert_eq!(
+                    extraction_rustflags(options.profile, options.mir_normalization),
+                    format!(
+                        "-Zalways-encode-mir -Zinline-mir={inline} -Zmir-enable-passes=-JumpThreading -Copt-level={optimization} -Ctarget-cpu={} -Ctarget-feature={}{hint}",
+                        profile.cpu(),
+                        profile.rustc_features()
+                    )
+                );
+            }
+        }
+        assert!(usage().contains("optimized-inline-hint-16384-v1"));
+    }
