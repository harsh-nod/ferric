+fn dead_cast_census_function_v1(
+    statements: Vec<SemanticStatementV1>,
+    terminator: SemanticTerminatorKindV1,
+) -> SemanticFunctionDeclV1 {
+    let (_, original) = dead_cast_fixture_v1();
+    dead_cast_function_v1(
+        &original,
+        original.locals().to_vec(),
+        vec![block(243, statements, terminator)],
