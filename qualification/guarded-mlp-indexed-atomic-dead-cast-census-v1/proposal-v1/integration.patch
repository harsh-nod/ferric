+    let first = locals.len();
+    for _ in 0..count {
+        locals.push(local(245, SemanticTypeIdV1::from_index(7), SemanticLocalRoleV1::Temporary));
+    }
+    let statements = (first..first + count)
+        .map(|index| statement(SemanticStatementKindV1::Deinitialize(
+            dead_cast_place_v1(index as u32, 7),
+        )))
+        .collect();
+    let function = dead_cast_function_v1(
+        &original, locals, vec![block(246, statements, SemanticTerminatorKindV1::Return)],
+    );
+    let inventory = AuthenticatedAtomicAllocationsV1::default();
+    let mut census = IndexedAtomicDeadCastCensusV1::new(&function);
+    for offset in 0..count {
+        assert!(census.temporary_unused(
+            &inventory,
+            ScalarAssignmentSiteV1 { block: 0, statement: offset },
+            SemanticLocalIdV1::from_index((first + offset) as u32),
+        ).unwrap());
+    }
+    // One initialization, one block/terminator, two units per statement, one per query.
+    let expected = function.locals().len() + 2 + 3 * count;
+    assert_eq!(inventory.work.get(), expected);
+    let reference_inventory = AuthenticatedAtomicAllocationsV1::default();
+    assert!(indexed_atomic_temporary_unused_reference_v1(
+        &function, &reference_inventory, ScalarAssignmentSiteV1 { block: 0, statement: 0 },
+        SemanticLocalIdV1::from_index(first as u32),
+    ).unwrap());
+    assert!(expected < reference_inventory.work.get() * count);
+}
