+fn dead_cast_census_compare_v1(function: &SemanticFunctionDeclV1) -> usize {
+    let inventory = AuthenticatedAtomicAllocationsV1::default();
+    let mut census = IndexedAtomicDeadCastCensusV1::new(function);
+    let mut queries = 0;
+    for (block, body) in function.blocks().iter().enumerate() {
+        // Includes an absent definition after the final statement.
+        for statement in 0..=body.statements().len() {
+            for index in 0..=function.locals().len() {
+                let site = ScalarAssignmentSiteV1 { block, statement };
+                let local = SemanticLocalIdV1::from_index(index as u32);
+                let expected = indexed_atomic_temporary_unused_reference_v1(
+                    function,
+                    &AuthenticatedAtomicAllocationsV1::default(),
+                    site,
+                    local,
+                )
+                .unwrap();
+                assert_eq!(
+                    census.temporary_unused(&inventory, site, local).unwrap(),
+                    expected,
+                    "block={block} statement={statement} local={index}",
+                );
+                queries += 1;
+            }
+        }
+    }
+    queries
+}
