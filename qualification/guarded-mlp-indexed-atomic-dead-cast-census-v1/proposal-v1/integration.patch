+fn dead_cast_census_statement_cases_v1() -> Vec<SemanticStatementV1> {
+    use fe2o3_mir_model::semantic_mir_v1::*;
+    let pointer = dead_cast_place_v1(12, 7);
+    let other = dead_cast_place_v1(11, 7);
+    let used = SemanticOperandV1::Copy(pointer.clone());
+    let constant = typed_constant(SemanticTypeIdV1::from_index(7), 0, 8);
+    let assignment = |destination, kind| {
+        statement(SemanticStatementKindV1::Assign(SemanticAssignmentV1::new(
+            destination,
+            SemanticRvalueV1::new(SemanticTypeIdV1::from_index(7), kind),
+        )))
+    };
+    let mut cases = vec![
+        assignment(pointer.clone(), SemanticRvalueKindV1::Use(constant.clone())),
+        assignment(other.clone(), SemanticRvalueKindV1::Use(used.clone())),
+        assignment(
+            other.clone(),
+            SemanticRvalueKindV1::Use(SemanticOperandV1::Move(pointer.clone())),
+        ),
+        assignment(
+            other.clone(),
+            SemanticRvalueKindV1::Unary {
+                operation: SemanticUnaryOpV1::Not,
+                operand: used.clone(),
+            },
+        ),
+        assignment(
+            other.clone(),
+            SemanticRvalueKindV1::Cast {
+                kind: SemanticCastKindV1::Pointer,
+                operand: used.clone(),
+            },
+        ),
+        assignment(
+            other.clone(),
+            SemanticRvalueKindV1::Borrow {
+                kind: SemanticBorrowKindV1::Shared,
+                place: pointer.clone(),
+            },
+        ),
+        assignment(
+            other.clone(),
+            SemanticRvalueKindV1::AddressOf {
+                mutability: SemanticMutabilityV1::Immutable,
+                place: pointer.clone(),
+            },
+        ),
+        assignment(other.clone(), SemanticRvalueKindV1::Length(pointer.clone())),
+        assignment(other.clone(), SemanticRvalueKindV1::Discriminant(pointer.clone())),
+        assignment(
+            other.clone(),
+            SemanticRvalueKindV1::Load(SemanticMemoryLoadV1::new(
+                pointer.clone(),
+                SemanticVolatilityV1::NonVolatile,
+                None,
+            )),
+        ),
+        statement(SemanticStatementKindV1::SetDiscriminant {
+            place: pointer.clone(),
+            variant_index: 0,
+        }),
+        statement(SemanticStatementKindV1::Deinitialize(pointer.clone())),
+        statement(SemanticStatementKindV1::Assume(used.clone())),
+        statement(SemanticStatementKindV1::StorageLive(SemanticLocalIdV1::from_index(12))),
+        statement(SemanticStatementKindV1::StorageDead(SemanticLocalIdV1::from_index(12))),
+        statement(SemanticStatementKindV1::Nop),
+    ];
+    for position in 0..2 {
+        let left = if position == 0 { used.clone() } else { constant.clone() };
+        let right = if position == 1 { used.clone() } else { constant.clone() };
+        cases.extend([
+            assignment(
+                other.clone(),
+                SemanticRvalueKindV1::Binary {
+                    operation: SemanticBinaryOpV1::Add,
+                    left: left.clone(),
+                    right: right.clone(),
+                },
+            ),
+            assignment(
+                other.clone(),
+                SemanticRvalueKindV1::CheckedBinary(SemanticCheckedBinaryRvalueV1::new(
+                    SemanticCheckedBinaryOpV1::Add, left.clone(), right.clone(),
+                )),
+            ),
+            assignment(
+                other.clone(),
+                SemanticRvalueKindV1::UncheckedBinary(SemanticUncheckedBinaryRvalueV1::new(
+                    SemanticUncheckedBinaryOpV1::Add, left.clone(), right.clone(),
+                )),
+            ),
+            assignment(
+                other.clone(),
+                SemanticRvalueKindV1::aggregate(
+                    SemanticAggregateKindV1::Tuple, vec![left, right],
+                )
+                .unwrap(),
+            ),
+            statement(SemanticStatementKindV1::Store(SemanticMemoryStoreV1::new(
+                if position == 0 { pointer.clone() } else { other.clone() },
+                if position == 1 { used.clone() } else { constant.clone() },
+                SemanticVolatilityV1::NonVolatile,
+                None,
+            ))),
+        ]);
+    }
+    let atomic = SemanticAtomicAccessV1::new(
+        SemanticAtomicOrderingV1::AcquireRelease,
+        SemanticAtomicScopeV1::System,
+    );
+    for position in 0..3 {
+        cases.push(statement(SemanticStatementKindV1::AtomicRmw(
+            SemanticAtomicRmwV1::new(
+                if position == 0 { pointer.clone() } else { other.clone() },
+                if position == 1 { pointer.clone() } else { other.clone() },
+                if position == 2 { used.clone() } else { constant.clone() },
+                SemanticAtomicRmwOpV1::Add,
+                atomic,
+            ),
+        )));
+    }
+    for position in 0..4 {
+        cases.push(statement(SemanticStatementKindV1::AtomicCompareExchange(
+            SemanticAtomicCompareExchangeV1::new(
+                if position == 0 { pointer.clone() } else { other.clone() },
+                if position == 1 { pointer.clone() } else { other.clone() },
+                if position == 2 { used.clone() } else { constant.clone() },
+                if position == 3 { used.clone() } else { constant.clone() },
+                atomic,
+                SemanticAtomicOrderingV1::Acquire,
+                false,
+            ),
+        )));
+    }
+    for base in [1, u32::MAX] {
+        let projected = SemanticPlaceV1::new(
+            SemanticLocalIdV1::from_index(base),
+            vec![
+                SemanticProjectionV1::new(
+                    SemanticProjectionKindV1::Index(SemanticLocalIdV1::from_index(12)),
+                    SemanticTypeIdV1::from_index(0),
+                )
+                .unwrap(),
+            ],
+            SemanticTypeIdV1::from_index(0),
+        )
+        .unwrap();
+        cases.push(statement(SemanticStatementKindV1::Deinitialize(projected)));
+    }
+    assert_eq!(cases.len(), 35);
+    cases
+}
