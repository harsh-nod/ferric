+fn dead_cast_census_terminator_cases_v1() -> Vec<SemanticTerminatorKindV1> {
+    use fe2o3_mir_model::semantic_mir_v1::*;
+    let pointer = dead_cast_place_v1(12, 7);
+    let used = SemanticOperandV1::Copy(pointer.clone());
+    let constant = typed_constant(SemanticTypeIdV1::from_index(7), 0, 8);
+    let condition = typed_constant(SemanticTypeIdV1::from_index(9), 1, 1);
+    let assert = |condition, message| SemanticTerminatorKindV1::Assert {
+        condition,
+        expected: true,
+        message,
+        target: cfg_edge(SemanticEdgeRoleV1::AssertSuccess, 0),
+        unwind: SemanticUnwindActionV1::Unreachable,
+    };
+    let mut cases = vec![
+        SemanticTerminatorKindV1::Call(
+            SemanticDirectCallV1::new_callable(
+                SemanticCallableIdV1::from_index(0),
+                vec![constant.clone(), used.clone()],
+                None,
+                SemanticUnwindActionV1::Unreachable,
+            )
+            .unwrap(),
+        ),
+        SemanticTerminatorKindV1::Call(
+            SemanticDirectCallV1::new_callable(
+                SemanticCallableIdV1::from_index(0),
+                vec![],
+                Some(SemanticCallDestinationV1::new(
+                    pointer.clone(), cfg_edge(SemanticEdgeRoleV1::CallReturn, 0),
+                )),
+                SemanticUnwindActionV1::Unreachable,
+            )
+            .unwrap(),
+        ),
+        SemanticTerminatorKindV1::TailCall(
+            SemanticDirectTailCallV1::new_callable(
+                SemanticCallableIdV1::from_index(0),
+                vec![constant.clone(), used.clone()],
+                SemanticUnwindActionV1::Unreachable,
+            )
+            .unwrap(),
+        ),
+        SemanticTerminatorKindV1::SwitchInt {
+            discriminant: used.clone(),
+            targets: SemanticSwitchTargetsV1::new(
+                vec![], cfg_edge(SemanticEdgeRoleV1::SwitchOtherwise, 0),
+            )
+            .unwrap(),
+        },
+        SemanticTerminatorKindV1::Drop {
+            place: pointer,
+            drop_glue: SemanticFunctionIdV1::from_index(0),
+            target: cfg_edge(SemanticEdgeRoleV1::DropReturn, 0),
+            unwind: SemanticUnwindActionV1::Unreachable,
+        },
+        assert(used.clone(), SemanticAssertMessageV1::NullPointerDereference),
+        assert(condition.clone(), SemanticAssertMessageV1::DivisionByZero(used.clone())),
+        assert(condition.clone(), SemanticAssertMessageV1::RemainderByZero(used.clone())),
+        assert(condition.clone(), SemanticAssertMessageV1::NullPointerDereference),
+        assert(condition.clone(), SemanticAssertMessageV1::ResumedAfterReturn),
+        assert(condition.clone(), SemanticAssertMessageV1::ResumedAfterPanic),
+        SemanticTerminatorKindV1::Goto(cfg_edge(SemanticEdgeRoleV1::Goto, 0)),
+        SemanticTerminatorKindV1::FalseEdge {
+            real_target: cfg_edge(SemanticEdgeRoleV1::FalseEdgeReal, 0),
+            imaginary_target: cfg_edge(SemanticEdgeRoleV1::FalseEdgeImaginary, 0),
+        },
+        SemanticTerminatorKindV1::Return,
+        SemanticTerminatorKindV1::UnwindResume,
+        SemanticTerminatorKindV1::UnwindTerminate,
+        SemanticTerminatorKindV1::Abort,
+        SemanticTerminatorKindV1::Unreachable,
+    ];
+    for position in 0..2 {
+        let left = if position == 0 { used.clone() } else { constant.clone() };
+        let right = if position == 1 { used.clone() } else { constant.clone() };
+        for message in [
+            SemanticAssertMessageV1::BoundsCheck { length: left.clone(), index: right.clone() },
+            SemanticAssertMessageV1::Overflow {
+                operation: SemanticBinaryOpV1::Add, left: left.clone(), right: right.clone(),
+            },
+            SemanticAssertMessageV1::MisalignedPointerDereference {
+                required_alignment: left, found_alignment: right,
+            },
+        ] {
+            cases.push(assert(condition.clone(), message));
+        }
+    }
+    assert_eq!(cases.len(), 24);
+    cases
+}
