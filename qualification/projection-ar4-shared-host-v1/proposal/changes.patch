+fn projection_shared_default_setup_does_not_configure_performance() {
+    let mut setup = Setup::default();
+    assert_eq!(configure_observer(&mut setup, Policy::DefaultFull).unwrap(), 0);
+    assert_eq!(setup.events, ["enable"]);
+    assert!(setup.options.is_empty());
+}
