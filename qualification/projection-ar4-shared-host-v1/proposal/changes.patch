+    let mut setup = Setup::default();
+    configure_observer(&mut setup, Policy::SharedFull).unwrap();
+    assert_eq!(setup.events, ["configure", "enable"]);
+    assert_eq!(setup.options, [(false, false, true)]);
+    assert!(configure_observer(&mut setup, Policy::SharedFull).is_err());
+    assert_eq!(setup.events, ["configure", "enable", "configure"]);
+}
+
+#[test]
+fn projection_shared_setup_refusal_never_enables_after_failed_configuration() {
+    let mut setup = Setup { fail_configure: true, ..Setup::default() };
+    assert!(configure_observer(&mut setup, Policy::SharedFull).is_err());
+    assert_eq!(setup.events, ["configure"]);
+    assert!(!setup.enabled);
+    let mut setup = Setup { fail_enable: true, ..Setup::default() };
+    assert!(configure_observer(&mut setup, Policy::SharedFull).is_err());
+    assert_eq!(setup.events, ["configure", "enable"]);
+    assert!(!setup.enabled);
+}
