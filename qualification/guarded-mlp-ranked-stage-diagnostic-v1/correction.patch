+#[test]
+fn structural_validation_stage_diagnostic_preserves_tags_and_error_sources() {
+    use RankedStructuralValidationStageV1 as Stage;
+    use fe2o3_lower_mir_kernel::{
+        ProductionMirPlironTranslationErrorV1 as Translation, ProductionSemanticKirErrorV1 as Cause,
+    };
+    use std::error::Error;
+
+    let stages = [
+        (Stage::FiniteReplay, "finite-replay"),
+        (Stage::WaveReplay, "wave-replay"),
+        (Stage::FiniteSourceSelection, "finite-source-selection"),
+        (Stage::WaveSourceSelection, "wave-source-selection"),
+        (Stage::FiniteSourceCall, "finite-source-call"),
+        (Stage::FiniteGeneratedEffects, "finite-generated-effects"),
+        (Stage::RankedCandidateCustody, "ranked-candidate-custody"),
+    ];
+    for (stage, label) in stages {
+        let diagnostic = ProductionRankedProjectionErrorV1::StructuralValidationAt {
+            stage,
+            root: Some(SemanticFunctionIdV1::from_index(u32::MAX)),
+            body: SemanticFunctionIdV1::from_index(u32::MAX),
+            error: Cause::CorrespondenceMismatch,
+        };
+        assert_eq!(
+            diagnostic.to_string(),
+            format!(
+                "ranked projection structural validation failed: stage {label}; root 4294967295; body 4294967295: {}",
+                Cause::CorrespondenceMismatch,
+            ),
+        );
+        assert!(matches!(
+            diagnostic.source().unwrap().downcast_ref::<Cause>(),
+            Some(Cause::CorrespondenceMismatch),
+        ));
+        assert!(diagnostic.source().unwrap().source().is_none());
+
+        let nested = ProductionRankedProjectionErrorV1::StructuralValidationAt {
+            stage,
+            root: None,
+            body: SemanticFunctionIdV1::from_index(0),
+            error: Cause::MirPlironTranslation(Translation::ResourceLimit),
+        };
+        assert!(matches!(
+            nested.source().unwrap().downcast_ref::<Cause>(),
+            Some(Cause::MirPlironTranslation(Translation::ResourceLimit)),
+        ));
+        assert!(matches!(
+            nested
+                .source()
+                .unwrap()
+                .source()
+                .unwrap()
+                .downcast_ref::<Translation>(),
+            Some(Translation::ResourceLimit),
+        ));
+    }
+}
