+#[test]
+fn structural_validation_stage_replay_tags_real_owner_refusals() {
+    use RankedStructuralValidationStageV1 as Stage;
+    use fe2o3_lower_mir_kernel::ProductionSemanticKirErrorV1 as Cause;
+
+    let program = neutral_ranked_program_v1();
+    let source = RankedProjectionSourceV1::from_legacy(&program.materialized).unwrap();
+    let semantic = source.semantic_ssa().source_semantic();
+    let root = semantic.roots()[0];
+    let body = semantic
+        .select_kernel_body_for_root_v1(root)
+        .unwrap()
+        .body();
+    let foreign = SemanticFunctionIdV1::from_index(u32::MAX);
+    assert!(!semantic.roots().contains(&foreign));
+    assert!(
+        source
+            .finite_join_view_for_root(root, body)
+            .unwrap()
+            .is_none()
+    );
+    let finite = match source.finite_join_view_for_root(foreign, body) {
+        Err(error) => error,
+        Ok(_) => panic!("foreign finite replay root must be refused"),
+    };
+    assert!(matches!(
+        finite,
+        ProductionRankedProjectionErrorV1::StructuralValidationAt {
+            stage: Stage::FiniteReplay,
+            root: Some(selected),
+            body: failed_body,
+            error: Cause::CorrespondenceMismatch,
+        } if selected == foreign && failed_body == body
+    ));
+    with_projection_source_budget_v1(&source, |budget| {
+        let floor = budget.storage();
+        assert!(
+            source
+                .wave_task_view_for_root(root, body, budget)?
+                .is_none()
+        );
+        assert_eq!(budget.storage(), floor);
+        let wave = match source.wave_task_view_for_root(foreign, body, budget) {
+            Err(error) => error,
+            Ok(_) => panic!("foreign wave replay root must be refused"),
+        };
+        assert!(matches!(
+            wave,
+            ProductionRankedProjectionErrorV1::StructuralValidationAt {
+                stage: Stage::WaveReplay,
+                root: Some(selected),
+                body: failed_body,
+                error: Cause::CorrespondenceMismatch,
+            } if selected == foreign && failed_body == body
+        ));
+        assert_eq!(budget.storage(), floor);
+        Ok(())
+    })
+    .unwrap();
+}
