+#[test]
+fn structural_validation_stage_context_preserves_inner_identity_and_legacy_display() {
+    use fe2o3_lower_mir_kernel::ProductionSemanticKirErrorV1 as Cause;
+    use std::error::Error;
+    let id = SemanticFunctionIdV1::from_index;
+    let make = |root| ProductionRankedProjectionErrorV1::StructuralValidationAt {
+        stage: RankedStructuralValidationStageV1::FiniteSourceCall,
+        root,
+        body: id(17),
+        error: Cause::CorrespondenceMismatch,
+    };
+    assert!(make(None).to_string().contains("; root unknown; body 17:"));
+    assert!(make(Some(id(0))).to_string().contains("; root 0; body 17:"));
+    for (original, expected) in [(None, id(23)), (Some(id(11)), id(11))] {
+        let diagnostic = make(original).with_deterministic_root_context(id(23), id(99), b"outer");
+        assert!(matches!(
+            diagnostic,
+            ProductionRankedProjectionErrorV1::StructuralValidationAt {
+                stage: RankedStructuralValidationStageV1::FiniteSourceCall,
+                root: Some(root),
+                body,
+                error: Cause::CorrespondenceMismatch,
+            } if root == expected && body == id(17)
+        ));
+    }
+    let legacy =
+        ProductionRankedProjectionErrorV1::StructuralValidation(Cause::CorrespondenceMismatch)
+            .with_deterministic_root_context(id(23), id(99), b"outer");
+    assert_eq!(
+        legacy.to_string(),
+        format!(
+            "ranked projection structural validation failed: {}",
+            Cause::CorrespondenceMismatch
+        ),
+    );
+    assert!(matches!(
+        legacy.source().unwrap().downcast_ref::<Cause>(),
+        Some(Cause::CorrespondenceMismatch),
+    ));
+}
