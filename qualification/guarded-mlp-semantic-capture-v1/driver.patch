+    #[test]
+    fn diagnostic_directory_refuses_aliases_and_keeps_existing_bytes() {
+        let scratch = ScratchDirectory::new().unwrap();
+        let destination = scratch.path.join(DIAGNOSTIC_NAMESPACE);
+        let directory = prepare_diagnostic_semantic_directory(&destination).unwrap();
+        assert_eq!(
