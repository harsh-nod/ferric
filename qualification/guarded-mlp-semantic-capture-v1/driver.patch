+    fn diagnostic_semantic_directory_option_is_default_off_and_strict() {
+        let scratch = ScratchDirectory::new().unwrap();
+        let root = &scratch.path;
+        assert!(
+            parse(&base_args(root), root)
+                .unwrap()
+                .diagnostic_semantic_dir
+                .is_none()
+        );
+        let destination = root.join(DIAGNOSTIC_NAMESPACE);
+        let mut args = base_args(root);
+        let delimiter = args.iter().position(|value| value == "--").unwrap();
+        args.splice(
+            delimiter..delimiter,
+            [
+                "--diagnostic-semantic-dir".into(),
+                destination.clone().into_os_string(),
+            ],
+        );
+        let options = parse(&args, root).unwrap();
+        assert_eq!(
+            options.diagnostic_semantic_dir.as_deref(),
+            Some(destination.as_path())
+        );
+        assert!(!destination.exists(), "parsing must not create diagnostics");
+        assert!(usage().contains("--diagnostic-semantic-dir"));
+        for bad in [
+            PathBuf::from(DIAGNOSTIC_NAMESPACE),
+            root.join("wrong"),
+            root.join("..").join(DIAGNOSTIC_NAMESPACE),
+        ] {
+            args[delimiter + 1] = bad.into_os_string();
+            assert!(parse(&args, root).is_err());
+        }
+        args[delimiter + 1] = destination.clone().into_os_string();
+        args.splice(
+            delimiter..delimiter,
+            [
+                "--diagnostic-semantic-dir".into(),
+                destination.into_os_string(),
+            ],
+        );
+        assert!(parse(&args, root).is_err(), "duplicate selector");
+        let mut args = base_args(root);
+        args.push("--diagnostic-semantic-dir".into());
+        args.push(root.join(DIAGNOSTIC_NAMESPACE).into_os_string());
+        assert!(
+            parse(&args, root).is_err(),
+            "Cargo passthrough cannot select diagnostics"
+        );
+        let mut args = base_args(root);
+        args.truncate(delimiter);
+        args.push("--diagnostic-semantic-dir".into());
+        assert!(parse(&args, root).is_err(), "missing diagnostic value");
+    }
