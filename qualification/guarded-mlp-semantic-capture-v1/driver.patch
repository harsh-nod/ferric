+            0o700
+        );
+        fs::write(destination.join("partial"), b"original partial bytes").unwrap();
+        assert!(prepare_diagnostic_semantic_directory(&destination).is_err());
+        drop(directory);
+        assert_eq!(
+            fs::read(destination.join("partial")).unwrap(),
+            b"original partial bytes"
+        );
+        let alias = scratch.path.join("alias");
+        std::os::unix::fs::symlink(&scratch.path, &alias).unwrap();
+        assert!(prepare_diagnostic_semantic_directory(&alias.join(DIAGNOSTIC_NAMESPACE)).is_err());
+        let other = scratch.path.join("other");
+        fs::create_dir(&other).unwrap();
+        std::os::unix::fs::symlink(
+            scratch.path.join("missing"),
+            other.join(DIAGNOSTIC_NAMESPACE),
+        )
+        .unwrap();
+        assert!(prepare_diagnostic_semantic_directory(&other.join(DIAGNOSTIC_NAMESPACE)).is_err());
+    }
