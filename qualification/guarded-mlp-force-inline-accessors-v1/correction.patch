+#[test]
+fn tile_accessor_bounds_and_rejection_preserve_existing_read_semantics() {
+    let mut f = Fixture::new();
+    let before = snapshot(&f.state);
+    for token in [1, 2, 97, 98, 193, 194, 195, 258] {
+        for lane in 0..WAVE_LANES {
+            let (mut written, mut valid, mut callbacks) = (0, true, 0);
+            let storage = f.storage();
+            execute_task_at_v2(
+                &storage,
+                token,
+                lane,
+                &mut written,
+                &mut valid,
+                &mut |task| {
+                    callbacks += 1;
+                    match task {
+                        WaveMlpTileTaskV2::Norm(mut task) => {
+                            assert_eq!(task.lane(), lane);
+                            assert_eq!(task.input(NORM_ELEMENTS - 1), Some(0x3f80));
+                            assert_eq!(task.weight(NORM_ELEMENTS - 1), Some(0x4000));
+                            for index in [NORM_ELEMENTS, usize::MAX] {
+                                assert_eq!(task.input(index), None);
+                                assert_eq!(task.weight(index), None);
+                            }
+                            task.reject();
+                            task.reject();
+                            assert_eq!(task.lane(), lane);
+                            // Immutable Norm roots remain readable after local rejection.
+                            assert_eq!(task.input(0), Some(0x3f80));
+                            assert_eq!(task.weight(0), Some(0x4000));
+                            assert!(!task.write_component(0, 0x1234));
+                        }
+                        WaveMlpTileTaskV2::Gate(mut task) => {
+                            let row = (token as usize - 2) * TILE_ROWS + TILE_ROWS - 1;
+                            assert_eq!(task.lane(), lane);
+                            assert_eq!(task.input(NORM_ELEMENTS - 1), Some(0xa55a));
+                            assert_eq!(
+                                task.weight(TILE_ROWS - 1, NORM_ELEMENTS - 1),
+                                Some(row as u16)
+                            );
+                            for index in [NORM_ELEMENTS, usize::MAX] {
+                                assert_eq!(task.input(index), None);
+                                assert_eq!(task.weight(0, index), None);
+                            }
+                            for row in [TILE_ROWS, usize::MAX] {
+                                assert_eq!(task.weight(row, 0), None);
+                            }
+                            task.reject();
+                            task.reject();
+                            assert_eq!(task.lane(), lane);
+                            assert_eq!(task.input(0), None);
+                            assert_eq!(
+                                task.weight(TILE_ROWS - 1, NORM_ELEMENTS - 1),
+                                Some(row as u16)
+                            );
+                            assert!(!task.write_column(0, 0x1234));
+                        }
+                        WaveMlpTileTaskV2::Up(mut task) => {
+                            let row = (token as usize - 98) * TILE_ROWS + TILE_ROWS - 1;
+                            let expected = Some(row as u16 + 8192);
+                            assert_eq!(task.lane(), lane);
+                            assert_eq!(task.input(NORM_ELEMENTS - 1), Some(0xa55a));
+                            assert_eq!(task.weight(TILE_ROWS - 1, NORM_ELEMENTS - 1), expected);
+                            for index in [NORM_ELEMENTS, usize::MAX] {
+                                assert_eq!(task.input(index), None);
+                                assert_eq!(task.weight(0, index), None);
+                            }
+                            for row in [TILE_ROWS, usize::MAX] {
+                                assert_eq!(task.weight(row, 0), None);
+                            }
+                            task.reject();
+                            task.reject();
+                            assert_eq!(task.lane(), lane);
+                            assert_eq!(task.input(0), None);
+                            assert_eq!(task.weight(TILE_ROWS - 1, NORM_ELEMENTS - 1), expected);
+                            assert!(!task.write_column(0, 0x1234));
+                        }
+                        WaveMlpTileTaskV2::SwiGlu(mut task) => {
+                            assert_eq!(task.lane(), lane);
+                            assert_eq!(task.gate(INTERMEDIATE_ELEMENTS - 1), Some(0xa55a));
+                            assert_eq!(task.up(INTERMEDIATE_ELEMENTS - 1), Some(0xa55a));
+                            for index in [INTERMEDIATE_ELEMENTS, usize::MAX] {
+                                assert_eq!(task.gate(index), None);
+                                assert_eq!(task.up(index), None);
+                            }
+                            task.reject();
+                            task.reject();
+                            assert_eq!(task.lane(), lane);
+                            assert_eq!(task.gate(0), None);
+                            assert_eq!(task.up(0), None);
+                            assert!(!task.write_component(0, 0x1234));
+                        }
+                        WaveMlpTileTaskV2::Down(mut task) => {
+                            let row = (token as usize - 195) * TILE_ROWS + TILE_ROWS - 1;
+                            let expected = Some(row as u16 + 16384);
+                            assert_eq!(task.lane(), lane);
+                            assert_eq!(task.input(INTERMEDIATE_ELEMENTS - 1), Some(0xa55a));
+                            assert_eq!(
+                                task.weight(TILE_ROWS - 1, INTERMEDIATE_ELEMENTS - 1),
+                                expected
+                            );
+                            for index in [INTERMEDIATE_ELEMENTS, usize::MAX] {
+                                assert_eq!(task.input(index), None);
+                                assert_eq!(task.weight(0, index), None);
+                            }
+                            for row in [TILE_ROWS, usize::MAX] {
+                                assert_eq!(task.weight(row, 0), None);
+                            }
+                            task.reject();
+                            task.reject();
+                            assert_eq!(task.lane(), lane);
+                            assert_eq!(task.input(0), None);
+                            assert_eq!(
+                                task.weight(TILE_ROWS - 1, INTERMEDIATE_ELEMENTS - 1),
+                                expected
+                            );
+                            assert!(!task.write_output(0, 123.0));
+                        }
+                    }
+                },
+            );
+            assert_eq!((callbacks, written, valid), (1, 0, false));
+            assert!(!complete_coverage(token, lane, written, valid));
+            assert_eq!(snapshot(storage.state()), before);
+        }
+    }
+    assert!(f.normalized.iter().all(|&word| word == 0xa55a));
+    assert!(f.gate.iter().all(|&word| word == 0xa55a));
+    assert!(f.up.iter().all(|&word| word == 0xa55a));
+    assert!(f.activation.iter().all(|&word| word == 0xa55a));
+    assert!(f.down.iter().all(|value| value.to_bits() == 0x7fc0_1234));
+    assert_eq!(snapshot(&f.state), before);
 }
 
