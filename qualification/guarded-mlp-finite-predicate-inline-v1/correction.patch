     #[test]
+    fn bf16_finiteness_matches_f32_for_every_encoding_without_mutation() {
+        const FINITE_CONST: bool = Bf16::ONE.is_finite();
+        const INFINITE_CONST: bool = Bf16::INFINITY.is_finite();
+        assert!(FINITE_CONST);
+        assert!(!INFINITE_CONST);
+
+        let mut finite_count = 0_u32;
+        let mut nonfinite_count = 0_u32;
+        for bits in 0_u16..=u16::MAX {
+            let value = Bf16::from_bits(bits);
+            // Use the host f32 classifier, independently of the BF16 mask.
+            let reference = f32::from_bits(u32::from(bits) << 16).is_finite();
+            assert_eq!(value.is_finite(), reference, "encoding {bits:#06x}");
+            assert_eq!(value.to_bits(), bits, "classification changed its input");
+            if reference {
+                finite_count += 1;
+            } else {
+                nonfinite_count += 1;
+            }
+        }
+        assert_eq!((finite_count, nonfinite_count), (65_280, 256));
+        for bits in [
+            0x0000, 0x8000, 0x0001, 0x8001, 0x007f, 0x807f, 0x0080, 0x8080, 0x7f7f, 0xff7f,
+        ] {
+            assert!(Bf16::from_bits(bits).is_finite());
+        }
+        for bits in [
+            0x7f80, 0xff80, 0x7f81, 0xff81, 0x7fc0, 0xffc0, 0x7fff, 0xffff,
+        ] {
+            assert!(!Bf16::from_bits(bits).is_finite());
+        }
+    }
