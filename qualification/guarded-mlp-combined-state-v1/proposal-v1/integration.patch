+#[test]
+fn all_owner_values_one_through_sixty_four_are_valid() {
+    for owner in 1..=64 {
+        let mut words = valid_state();
+        words[32..290].fill(owner);
+        assert!(host_oracle(&words));
+        assert!(mlp_state_valid_v1!(&words, plain_word));
+    }
+}
