+        let missing = &unresolved["calls"][0]["call_site"];
+        assert_eq!(missing["map_resolution"], "FileAbsent");
+        assert_eq!(missing["file_identity"], hex(&file));
+        assert_eq!(missing["byte_range"], json!([3, 9]));
+        assert_eq!(missing["display_path"], Value::Null);
+        assert_eq!(missing["file_bytes"], Value::Null);
+        assert_eq!(missing["source_file_contents_verified"], false);
+        assert!(inspect_call_fixture(raw, &map, 0, 0).is_err());
+        map["files"] =
+            json!([{"identity": hex(&file), "byte_len": 9, "display_path": "/display-only.rs"}]);
+        let value = inspect_census_fixture(raw, &map, CENSUS_LIMITS).unwrap();
+        assert_eq!(value["calls"][0]["call_site"]["file_identity"], hex(&file));
+        assert_eq!(value["calls"][0]["call_site"]["byte_range"], json!([3, 9]));
+        assert_eq!(
+            value["functions"][0]["call_site"]["file_identity"],
+            hex(&file)
+        );
+        assert_eq!(
+            value["calls"][0]["call_site"]["source_file_contents_verified"],
+            false
+        );
+        let bytes = serde_json::to_vec(&map).unwrap();
+        assert!(
+            inspect_census(raw, &bytes, &hex(&[0; 32]), &digest(&bytes), CENSUS_LIMITS).is_err()
+        );
+        assert!(inspect_census(raw, &bytes, &digest(raw), &hex(&[0; 32]), CENSUS_LIMITS).is_err());
+        for changed in [raw[..raw.len() - 1].to_vec(), [raw, &[0]].concat()] {
