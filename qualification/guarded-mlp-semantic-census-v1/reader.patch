+#[derive(Clone, Copy)]
+struct CensusLimits {
+    functions: usize,
+    blocks: usize,
+    calls: usize,
+    output_bytes: usize,
+}
+
+const CENSUS_LIMITS: CensusLimits = CensusLimits {
+    functions: 128,
+    blocks: 131_072,
+    calls: 4096,
+    output_bytes: MAP_MAX - 1,
+};
+
+fn append_census_row(
+    rows: &mut Vec<Value>,
+    row: Value,
+    used: &mut usize,
+    maximum: usize,
+) -> Result<()> {
+    let bytes = serde_json::to_vec(&row)
+        .map_err(|_| "JSON output failed")?
+        .len()
+        .checked_add(usize::from(!rows.is_empty()))
+        .ok_or("census output limit")?;
+    let next = used.checked_add(bytes).ok_or("census output limit")?;
+    if next > maximum {
+        return Err("census output limit");
+    }
+    *used = next;
+    rows.push(row);
+    Ok(())
+}
+
+// Compiler maps can omit library files. Census rows retain their exact provenance,
+// but unresolved records never gain a path or a claim of source verification.
+fn census_origin(source: Option<SemanticSourceOriginV1>, map: &SourceMap) -> Result<Value> {
+    let Some(source) = source else {
+        return Ok(Value::Null);
+    };
+    let identity = hex(source.file().as_bytes());
+    if map.files.iter().any(|file| file.identity == identity) {
+        let mut value = origin(Some(source), map)?;
+        value["map_resolution"] = json!("RecordedFile");
+        return Ok(value);
+    }
+    let (start, end) = source.byte_range();
+    if start > end {
+        return Err("source origin reversed");
+    }
+    Ok(json!({
+        "file_identity": identity, "byte_range": [start, end],
+        "start": source.start_coordinate(), "end": source.end_coordinate(),
+        "map_resolution": "FileAbsent", "display_path": null, "file_bytes": null,
+        "source_file_contents_verified": false
+    }))
+}
+
+fn inspect_census(
+    raw: &[u8],
+    map_raw: &[u8],
+    mir_hash: &str,
+    map_hash: &str,
+    limits: CensusLimits,
+) -> Result<Value> {
+    if limits.functions > CENSUS_LIMITS.functions
+        || limits.blocks > CENSUS_LIMITS.blocks
+        || limits.calls > CENSUS_LIMITS.calls
+        || limits.output_bytes > CENSUS_LIMITS.output_bytes
+    {
+        return Err("census limits exceed fixed bounds");
+    }
+    let (semantic, map) = decode_capture(raw, map_raw, mir_hash, map_hash)?;
+    if semantic.functions().len() > limits.functions {
+        return Err("census function limit");
+    }
+    let mut block_count = 0;
+    let mut sites = Vec::new();
+    for (function_index, function) in semantic.functions().iter().enumerate() {
+        for (block_index, block) in function.blocks().iter().enumerate() {
+            if block_count == limits.blocks {
+                return Err("census block limit");
+            }
+            block_count += 1;
+            let (callable_id, kind) = match block.terminator().kind() {
+                SemanticTerminatorKindV1::Call(call) => (call.callee(), "Call"),
+                SemanticTerminatorKindV1::TailCall(call) => (call.callee(), "TailCall"),
+                _ => continue,
+            };
+            if sites.len() == limits.calls {
+                return Err("census call limit");
+            }
+            let callable = semantic
+                .callables()
+                .get(callable_id.index() as usize)
+                .ok_or("callable absent")?;
+            let callee = match callable {
+                SemanticCallableDeclV1::Defined { function } => Some(function.index()),
+                _ => None,
+            };
+            sites.push((
+                function_index,
+                block_index,
+                kind,
+                callable_id.index(),
+                callee,
+            ));
+        }
+    }
+    let mut result = inspection_record(
+        &semantic,
+        raw.len(),
+        mir_hash,
+        map_hash,
+        "fe2o3-semantic-call-census-v1",
+    );
+    result["kir_binding_types_observed"] = json!(false);
+    result["function_count"] = json!(semantic.functions().len());
+    result["block_count"] = json!(block_count);
+    result["call_count"] = json!(sites.len());
+    result["defined_call_count"] = json!(sites.iter().filter(|site| site.4.is_some()).count());
+    result["functions"] = json!([]);
+    result["calls"] = json!([]);
+    let mut used = serde_json::to_vec(&result)
+        .map_err(|_| "JSON output failed")?
+        .len();
+    if used > limits.output_bytes {
+        return Err("census output limit");
+    }
+    let mut functions = Vec::new();
+    for (index, function) in semantic.functions().iter().enumerate() {
+        let row = json!({
+            "function_index": index,
+            "identity": hex(function.identity().as_bytes()),
+            "item_definition_identity": hex(function.item_definition_identity().as_bytes()),
+            "role": format!("{:?}", function.role()),
+            "call_site": census_origin(function.source().call_site(), &map)?,
+            "expansion": census_origin(function.source().expansion(), &map)?,
+        });
+        append_census_row(&mut functions, row, &mut used, limits.output_bytes)?;
+    }
+    let mut calls = Vec::new();
+    for (function_index, block_index, kind, callable_index, callee) in sites {
+        let block = &semantic.functions()[function_index].blocks()[block_index];
+        let row = json!({
+            "function_index": function_index,
+            "block_index": block_index,
+            "block_identity": hex(block.identity().as_bytes()),
+            "terminator_kind": kind,
+            "callable_index": callable_index,
+            "callable_kind": if callee.is_some() { "Defined" } else { "NonDefined" },
+            "callee_function_index": callee,
+            "call_site": census_origin(block.terminator().source().call_site(), &map)?,
+            "expansion": census_origin(block.terminator().source().expansion(), &map)?,
+        });
+        append_census_row(&mut calls, row, &mut used, limits.output_bytes)?;
+    }
+    result["functions"] = json!(functions);
+    result["calls"] = json!(calls);
+    Ok(result)
+}
