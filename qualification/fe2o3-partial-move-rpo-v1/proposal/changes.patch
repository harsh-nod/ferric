+struct SemanticPartialMoveWorklistV1<'a> {
+    order: &'a [SsaBlockIdV1],
+    ranks: Vec<usize>,
+    queued: Vec<bool>,
+    next: usize,
+}
+
+impl<'a> SemanticPartialMoveWorklistV1<'a> {
+    fn new(
+        order: &'a [SsaBlockIdV1],
+        blocks: usize,
+        budget: &mut SemanticPartialMoveBudgetV1,
+    ) -> Result<Self, ProductionSemanticSsaErrorV1> {
+        // Auxiliary accounting reserves the inverse map before this allocation.
+        let mut ranks = Vec::with_capacity(blocks);
+        let mut queued = Vec::with_capacity(blocks);
+        for _ in 0..blocks {
+            budget.charge_work()?;
+            ranks.push(usize::MAX);
+            queued.push(false);
+        }
+        for (rank, block) in order.iter().enumerate() {
+            budget.charge_work()?;
+            let slot = ranks
+                .get_mut(block.get() as usize)
+                .ok_or(ProductionSemanticSsaErrorV1::ReplayMismatch)?;
+            if *slot != usize::MAX {
+                return Err(ProductionSemanticSsaErrorV1::ReplayMismatch);
+            }
+            *slot = rank;
+        }
+        Ok(Self { order, ranks, queued, next: order.len() })
+    }
+
+    fn push(
+        &mut self,
+        block: usize,
+        budget: &mut SemanticPartialMoveBudgetV1,
+    ) -> Result<(), ProductionSemanticSsaErrorV1> {
+        budget.charge_work()?;
+        let rank = *self.ranks.get(block)
+            .ok_or(ProductionSemanticSsaErrorV1::ReplayMismatch)?;
+        if rank == usize::MAX {
+            return Err(ProductionSemanticSsaErrorV1::ReplayMismatch);
+        }
+        self.queued[rank] = true;
+        self.next = self.next.min(rank);
+        Ok(())
+    }
+
+    fn pop(
+        &mut self,
+        budget: &mut SemanticPartialMoveBudgetV1,
+    ) -> Result<Option<usize>, ProductionSemanticSsaErrorV1> {
+        while let Some(block) = self.order.get(self.next) {
+            budget.charge_work()?;
+            let rank = self.next;
+            self.next += 1;
+            if std::mem::replace(&mut self.queued[rank], false) {
+                return Ok(Some(block.get() as usize));
+            }
+        }
+        Ok(None)
+    }
+}
