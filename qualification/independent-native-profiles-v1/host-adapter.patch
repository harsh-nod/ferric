+#[test]
+fn independent_profiles_failure_does_not_infer_device_absence_from_failed_open() {
+    let mut progress = ProfileProgress::new(Profile::BaselineV5);
+    assert!(progress.open::<()>(|| Err("partial open".into())).is_err());
+    let text = failure_report(report_shell(), &[progress], &[], &"x".repeat(4096)).unwrap();
+    let report: serde_json::Value = serde_json::from_str(&text).unwrap();
+    assert_eq!(report["native_execution_attempted"], true);
+    assert!(report["opened_device"].is_null());
+    assert_eq!(report["profiles"][0]["closed"], false);
+    assert_eq!(report["error"].as_str().unwrap().len(), 2048);
+    assert_nonclaims(&report);
+}
+
+#[test]
+fn independent_profiles_postcheck_failure_retains_both_closed_profiles_without_success() {
+    let mut progress = [ProfileProgress::new(Profile::BaselineV5), ProfileProgress::new(Profile::TilesV6)];
+    for profile in &mut progress {
+        profile.open(|| Ok(())).unwrap();
+        profile.close(|| Ok(())).unwrap();
+    }
+    let pins = capture_pins();
+    let text = failure_report(report_shell(), &progress, &pins, "capture or executable recheck failed").unwrap();
+    let report: serde_json::Value = serde_json::from_str(&text).unwrap();
+    assert_eq!(report["profiles"][0]["closed"], true);
+    assert_eq!(report["profiles"][1]["closed"], true);
+    assert_eq!(report["captures"], serde_json::to_value(&pins).unwrap());
+    assert_eq!(report["success"], false);
+    assert_eq!(report["completed_and_closed"], false);
+    assert_nonclaims(&report);
+}
