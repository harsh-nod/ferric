+use super::*;
+
+const INSPECT_FLAG: &str = "--inspect-independent-profiles-v1";
+const EXECUTE_FLAG: &str = "--execute-reviewed-engineering-prefix-independent-profiles-v1";
+const INSPECTION_SCHEMA: &str = "fe2o3-qwen-prefix-tiles-independent-profiles-inspection-v1";
+const OBSERVATION_SCHEMA: &str = "fe2o3-qwen-prefix-tiles-independent-profiles-observation-v1";
+const FAILURE_SCHEMA: &str = "fe2o3-qwen-prefix-tiles-independent-profiles-failure-v1";
+
+pub(super) fn mode(args: &[String]) -> Result<Option<(bool, &str, &str)>> {
+    let execute = match args.first().map(String::as_str) {
+        Some(INSPECT_FLAG) => false,
+        Some(EXECUTE_FLAG) => true,
+        _ => return Ok(None),
+    };
+    let [_, path, sha] = args else {
+        return Err("independent profiles require exactly REQUEST SHA256".into());
+    };
+    Ok(Some((execute, path, sha)))
+}
+
+fn coordinate_profiles(
+    backend: &mut impl ComparisonBackend,
+    prepared: &Prepared,
+) -> Result<[ClosedRun; 2]> {
+    validate_prepared(prepared)?;
+    // The closed child capture census requires baseline first. Each profile
+    // must independently pass its state, finite-output and untouched-KV checks.
+    let baseline = backend.execute(Profile::BaselineV5)?;
+    validate_run(&baseline, Profile::BaselineV5, prepared)?;
+    let tiles = backend.execute(Profile::TilesV6)?;
+    validate_run(&tiles, Profile::TilesV6, prepared)?;
+    Ok([baseline, tiles])
+}
+
+fn report_shell() -> serde_json::Value {
+    serde_json::json!({
+        "schema":INSPECTION_SCHEMA,"authority":"none","success":false,
+        "opened_device":false,"native_execution_attempted":false,
+        "completed_and_closed":false,"immutable_input_readbacks_match":false,
+        "paired_comparison_performed":false,"bitwise_match":false,
+        "independent_numerical_acceptance":false,"full_model_correctness":false,
+        "performance_claim":false,"production_authority":false,"runtime_premises_discharged":false,
+        "scheduler_progress_guaranteed":false,"all_workgroups_participated":false,
+        "profiles":[],"captures":[]
+    })
+}
+
+fn inspection_report(loaded: &Loaded, prepared: &Prepared, sha: &str) -> serde_json::Value {
+    let mut report = report_shell();
+    let scope = serde_json::json!({
+        "request_sha256":sha,"baseline_request":loaded.request.baseline_request,
+        "baseline_image_sha256":loaded.baseline.prefix[0].object_sha256,"tiles":loaded.request.tiles,
+        "devices":loaded.baseline.device_ids,"history_kind":loaded.baseline.history_kind,
+        "position":loaded.baseline.position,"reviews":loaded.request.reviews,
+        "input_sha256":prepared.inputs.each_ref().map(|rank| rank.each_ref().map(|b| fixture::sha256(b))),
+        "initial_output_sha256":prepared.initial.each_ref().map(|rank| rank.each_ref().map(|b| fixture::sha256(b))),
+        "data_root_bytes":EXTENTS,"v5_grid":[128,1,1],"v6_grid":[4096,1,1],"workgroup":[64,1,1],
+        "stage_order":STAGES,"capture_bytes_per_rank":CAPTURE_BYTES,
+        "capture_format":"little-endian concatenation of six BF16 buffers then one FP32 buffer; whole KV caches included"
+    });
+    for (key, value) in scope.as_object().expect("literal object") {
+        report[key] = value.clone();
+    }
+    report
+}
+
+fn observation_report(
+    mut report: serde_json::Value,
+    runs: &[ClosedRun; 2],
+    captures: &[[FilePin; 2]],
+) -> Result<String> {
+    if runs[0].profile != Profile::BaselineV5
+        || runs[1].profile != Profile::TilesV6
+        || runs.iter().any(|run| !run.closed)
+        || captures.len() != 2
+    {
+        return Err("two ordered independently closed profiles and capture pairs required".into());
+    }
+    report["schema"] = OBSERVATION_SCHEMA.into();
+    report["success"] = true.into();
+    report["opened_device"] = true.into();
+    report["native_execution_attempted"] = true.into();
+    report["completed_and_closed"] = true.into();
+    report["immutable_input_readbacks_match"] = true.into();
+    report["profiles"] = serde_json::json!(runs.each_ref().map(|r| serde_json::json!({
+        "profile":r.profile,"states":r.states,"host_dispatch_elapsed_ns":r.host_elapsed_ns,"closed":r.closed
+    })));
+    report["captures"] = serde_json::to_value(captures).map_err(|e| e.to_string())?;
+    report["timing_boundary"] = "host currentness/kernarg/publish through GPU completion and idle; not device-only or a benchmark".into();
+    encoded_report(&report)
+}
+
+fn failure_report(
+    mut report: serde_json::Value,
+    progress: &[ProfileProgress],
+    captures: &[[FilePin; 2]],
+    error: &str,
+) -> Result<String> {
+    report["schema"] = FAILURE_SCHEMA.into();
+    report["success"] = false.into();
+    report["completed_and_closed"] = false.into();
+    report["immutable_input_readbacks_match"] = false.into();
+    report["native_execution_attempted"] = progress.iter().any(|p| p.group_open_attempted).into();
+    report["opened_device"] = if progress.iter().any(|p| p.group_open_returned) {
+        true.into()
+    } else if progress.iter().any(|p| p.group_open_attempted) {
+        serde_json::Value::Null
+    } else {
+        false.into()
+    };
+    report["profiles"] = serde_json::to_value(progress).map_err(|e| e.to_string())?;
+    report["captures"] = serde_json::to_value(captures).map_err(|e| e.to_string())?;
+    report["error"] = error.chars().take(2048).collect::<String>().into();
+    report["failure_containment"] = "no close retry or in-process fallback; child exits, external owner must reap and audit idle".into();
+    encoded_report(&report)
+}
+
+pub(super) fn run(execute: bool, path: &str, sha: &str) -> Result<()> {
+    // Use the existing exact request, six scoped reviews, descriptor, immutable
+    // fixture and freshness gates. This route grants no new runtime authority.
+    let loaded = load(path, sha)?;
+    let prepared = prepare(&loaded)?;
+    let report = inspection_report(&loaded, &prepared, sha);
+    if !execute {
+        println!("{}", encoded_report(&report)?);
+        return Ok(());
+    }
+    let directory = capture_path(&loaded.request.capture_directory)?;
+    std::fs::DirBuilder::new()
+        .mode(0o700)
+        .create(&directory)
+        .map_err(|e| e.to_string())?;
+    let mut native = Native {
+        prepared: &prepared,
+        directory: &directory,
+        request: process::request_pin(path, sha)?,
+        executable: process::Executable::current(None)?,
+        child_pids: Vec::new(),
+        captures: Vec::new(),
+        progress: Vec::new(),
+        comparison: None,
+    };
+    let outcome = (|| {
+        // Native::execute still authenticates/reaps a disposable child through
+        // process::execute; no raw-child route or old parity failure is used.
+        let runs = coordinate_profiles(&mut native, &prepared)?;
+        if native.comparison.is_some() {
+            return Err("independent profiles must not retain comparison rows".into());
+        }
+        for pins in &native.captures {
+            for pin in pins {
+                pinned(pin, CAPTURE_BYTES)?;
+            }
+        }
+        native.executable.check()?;
+        observation_report(report.clone(), &runs, &native.captures)
+    })();
+    match outcome {
+        Ok(text) => {
+            println!("{text}");
+            Ok(())
+        }
+        Err(error) => {
+            println!(
+                "{}",
+                failure_report(report, &native.progress, &native.captures, &error)?
+            );
+            Err(error)
+        }
+    }
+}
