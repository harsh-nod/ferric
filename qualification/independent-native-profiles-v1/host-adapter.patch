+fn independent_profiles_failure_preserves_closed_baseline_and_uncertain_candidate() {
+    let mut baseline = ProfileProgress::new(Profile::BaselineV5);
+    baseline.open(|| Ok(())).unwrap();
+    baseline.close(|| Ok(())).unwrap();
+    let mut tiles = ProfileProgress::new(Profile::TilesV6);
+    tiles.open(|| Ok(())).unwrap();
+    assert!(tiles.close(|| Err("uncertain close".into())).is_err());
+    let progress = [baseline, tiles];
+    let pins = capture_pins();
+    let text = failure_report(report_shell(), &progress, &pins[..1], "candidate failed").unwrap();
+    let report: serde_json::Value = serde_json::from_str(&text).unwrap();
+    assert_eq!(report["schema"], FAILURE_SCHEMA);
+    assert_eq!(report["success"], false);
+    assert_eq!(report["completed_and_closed"], false);
+    assert_eq!(report["immutable_input_readbacks_match"], false);
+    assert_eq!(report["profiles"], serde_json::to_value(&progress).unwrap());
+    assert_eq!(report["captures"], serde_json::to_value(&pins[..1]).unwrap());
+    assert_eq!(report["opened_device"], true);
+    assert_nonclaims(&report);
+}
