+use super::*;
+
+fn prepared() -> Prepared {
+    Prepared {
+        inputs: core::array::from_fn(|_| core::array::from_fn(|role| vec![0; EXTENTS[role]])),
+        initial: core::array::from_fn(|_| {
+            core::array::from_fn(|stage| {
+                if stage == 6 {
+                    0x7fc0_2150_u32.to_le_bytes().repeat(EXTENTS[7 + stage] / 4)
+                } else {
+                    0x7fc1_u16.to_le_bytes().repeat(EXTENTS[7 + stage] / 2)
+                }
+            })
+        }),
+        slots: [17, 17],
+    }
+}
+
+fn closed(profile: Profile, prepared: &Prepared) -> ClosedRun {
+    let mut words = match profile {
+        Profile::BaselineV5 => vec![64; 22],
+        Profile::TilesV6 => vec![64; 284],
+    };
+    match profile {
+        Profile::BaselineV5 => {
+            words[..6].copy_from_slice(&[1, 0, 65535, 65535, 0x5555_5555, 0]);
+        }
+        Profile::TilesV6 => {
+            words[..4].copy_from_slice(&[1, 0, 0, 31]);
+            words[4..9].copy_from_slice(&[1, 48, 1, 16, 64]);
+            words[9..14].copy_from_slice(&[1, 48, 1, 16, 64]);
+            words[14..19].copy_from_slice(&[u32::MAX, u32::MAX, u32::MAX, u32::MAX, 3]);
+            words[19..24].copy_from_slice(&[u32::MAX, u32::MAX, u32::MAX, u32::MAX, 3]);
+            words[24..154].fill(1);
+        }
+    }
+    ClosedRun {
+        profile,
+        states: [words.clone(), words],
+        host_elapsed_ns: [1, 2],
+        outputs: core::array::from_fn(|rank| {
+            core::array::from_fn(|stage| {
+                if matches!(stage, 3 | 4) {
+                    let mut bytes = prepared.initial[rank][stage].clone();
+                    let start = prepared.slots[rank] * 1024;
+                    bytes[start..start + 1024].fill(0);
+                    bytes
+                } else {
+                    vec![0; EXTENTS[7 + stage]]
+                }
+            })
+        }),
+        closed: true,
+    }
+}
+
+#[derive(Clone, Copy)]
+enum Mutation {
+    None,
+    ExecutionError,
+    Unclosed,
+    WrongProfile,
+    State(usize),
+    Nonfinite(usize, usize, bool),
+    UntouchedKv(usize, usize, bool),
+    ShortOutput,
+    DifferentFiniteOutputs,
+}
+
+struct Fake<'a> {
+    prepared: &'a Prepared,
+    calls: Vec<Profile>,
+    target: Profile,
+    mutation: Mutation,
+    comparison_rows: usize,
+}
+
+impl ComparisonBackend for Fake<'_> {
+    fn execute(&mut self, profile: Profile) -> Result<ClosedRun> {
+        self.calls.push(profile);
+        if profile == self.target && matches!(self.mutation, Mutation::ExecutionError) {
+            return Err("native phase failure".into());
+        }
+        let mut run = closed(profile, self.prepared);
+        if profile == self.target {
+            match self.mutation {
+                Mutation::None | Mutation::ExecutionError => {}
+                Mutation::Unclosed => run.closed = false,
+                Mutation::WrongProfile => {
+                    run.profile = match profile {
+                        Profile::BaselineV5 => Profile::TilesV6,
+                        Profile::TilesV6 => Profile::BaselineV5,
+                    };
+                }
+                Mutation::State(rank) => run.states[rank][0] = 0,
+                Mutation::Nonfinite(rank, stage, nan) => {
+                    let offset = if matches!(stage, 3 | 4) {
+                        self.prepared.slots[rank] * 1024
+                    } else {
+                        0
+                    };
+                    if stage == 6 {
+                        let bits: u32 = if nan { 0x7fc0_2150 } else { 0x7f80_0000 };
+                        run.outputs[rank][stage][offset..offset + 4]
+                            .copy_from_slice(&bits.to_le_bytes());
+                    } else {
+                        let bits: u16 = if nan { 0x7fc1 } else { 0x7f80 };
+                        run.outputs[rank][stage][offset..offset + 2]
+                            .copy_from_slice(&bits.to_le_bytes());
+                    }
+                }
+                Mutation::UntouchedKv(rank, stage, after) => {
+                    let start = self.prepared.slots[rank] * 1024;
+                    let offset = if after { start + 1024 } else { start - 2 };
+                    run.outputs[rank][stage][offset] ^= 1;
+                }
+                Mutation::ShortOutput => {
+                    run.outputs[1][6].pop();
+                }
+                Mutation::DifferentFiniteOutputs => {
+                    for rank in 0..2 {
+                        for stage in 0..7 {
+                            let offset = if matches!(stage, 3 | 4) {
+                                self.prepared.slots[rank] * 1024
+                            } else {
+                                0
+                            };
+                            if stage == 6 {
+                                run.outputs[rank][stage][offset..offset + 4]
+                                    .copy_from_slice(&1_f32.to_bits().to_le_bytes());
+                            } else {
+                                run.outputs[rank][stage][offset..offset + 2]
+                                    .copy_from_slice(&0x3f80_u16.to_le_bytes());
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        Ok(run)
+    }
+
+    fn retain_comparison(&mut self, rows: &[StageMatch]) {
+        self.comparison_rows += rows.len();
+    }
+}
+
+fn fake(prepared: &Prepared, target: Profile, mutation: Mutation) -> Fake<'_> {
+    Fake { prepared, calls: vec![], target, mutation, comparison_rows: 0 }
+}
+
+fn assert_failed(prepared: &Prepared, target: Profile, mutation: Mutation) {
+    let mut backend = fake(prepared, target, mutation);
+    assert!(coordinate_profiles(&mut backend, prepared).is_err());
+    let expected: &[Profile] = match target {
+        Profile::BaselineV5 => &[Profile::BaselineV5],
+        Profile::TilesV6 => &[Profile::BaselineV5, Profile::TilesV6],
+    };
+    assert_eq!(backend.calls, expected);
+    assert_eq!(backend.comparison_rows, 0);
+}
+
+fn capture_pins() -> [[FilePin; 2]; 2] {
+    ["baseline-v5", "tiles-v6"].map(|profile| {
+        core::array::from_fn(|rank| FilePin {
+            path: format!("/unused/{profile}-rank{rank}.bin"),
+            bytes: CAPTURE_BYTES,
+            sha256: "11".repeat(32),
+        })
+    })
+}
+
+fn assert_nonclaims(report: &serde_json::Value) {
+    assert_eq!(report["authority"], "none");
+    for key in [
+        "paired_comparison_performed", "bitwise_match", "independent_numerical_acceptance",
+        "full_model_correctness", "performance_claim", "production_authority",
+        "runtime_premises_discharged", "scheduler_progress_guaranteed",
+        "all_workgroups_participated",
+    ] {
+        assert_eq!(report[key], false, "{key}");
+    }
+    for key in ["stages", "comparison", "comparison_rows"] {
+        assert!(report.get(key).is_none(), "no paired rows: {key}");
+    }
+}
