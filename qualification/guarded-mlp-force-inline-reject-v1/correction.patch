+#[test]
+fn norm_reject_preserves_payload_and_uses_ordinary_error_retirement() {
+    let mut f = Fixture::new();
+    let mut results = [observation(); WAVE_LANES];
+    let mut retired = [false; WAVE_LANES];
+    let token = begin_round_claim(&f.state, 0, 0, &mut retired[0], &mut results[0]);
+    assert_eq!(token, 1);
+    let before = snapshot(&f.state);
+    {
+        let storage = f.storage();
+        for lane in 0..WAVE_LANES {
+            let (mut written, mut valid, mut callbacks) = (0, true, 0);
+            execute_task_at_v2(
+                &storage,
+                token,
+                lane,
+                &mut written,
+                &mut valid,
+                &mut |task| match task {
+                    WaveMlpTileTaskV2::Norm(mut task) => {
+                        callbacks += 1;
+                        assert_eq!(task.lane(), lane);
+                        task.reject();
+                        task.reject();
+                        assert!(!task.write_component(0, 0x1234));
+                    }
+                    _ => panic!("norm token must issue a norm task"),
+                },
+            );
+            assert_eq!((callbacks, written, valid), (1, 0, false));
+            assert!(!complete_coverage(token, lane, written, valid));
+            assert_eq!(snapshot(storage.state()), before);
+        }
+    }
+    assert!(f.normalized.iter().all(|&word| word == 0xa55a));
+    assert!(f.gate.iter().all(|&word| word == 0xa55a));
+    assert!(f.up.iter().all(|&word| word == 0xa55a));
+    assert!(f.activation.iter().all(|&word| word == 0xa55a));
+    assert!(f.down.iter().all(|value| value.to_bits() == 0x7fc0_1234));
+    for lane in 0..WAVE_LANES {
+        finish_round_completion(
+            &f.state,
+            token,
+            false,
+            &mut retired[lane],
+            &mut results[lane],
+        );
+        assert!(retired[lane]);
+        assert_eq!(results[lane].error, INCOMPLETE_WRITES);
+        assert_eq!(results[lane].executed_tasks, 0);
+    }
+    assert_eq!(f.state[ERRORS].load(Ordering::Acquire), INCOMPLETE_WRITES);
+    assert_eq!(f.state[ARRIVALS].load(Ordering::Acquire), 0);
+    assert_eq!(f.state[DONE].load(Ordering::Acquire), 0);
+    let failed = snapshot(&f.state);
+    assert_eq!(
+        begin_round_claim(&f.state, 0, 0, &mut retired[0], &mut results[0]),
+        STOP
+    );
+    finish_round_completion(&f.state, STOP, true, &mut retired[0], &mut results[0]);
+    assert_eq!(snapshot(&f.state), failed);
 }
 
