+fn ordered_parent_bootstrap_is_not_plain_projection_profile() {
+    let c=config();let base=wire::tests::bootstrap(wire::InputMode::Autoregressive);
+    let old=super::super::projection::bootstrap(base.clone(),&c.projection_residual_image).unwrap();
