+            assert!(f.poisoned);
+            let mut bytes = &output[..];
+            let mut budget = FrameBudget::new();
+            while let Some((reply, _, _)) = selected::read_response(&mut bytes, &mut budget).unwrap() {
+                assert!(!reply.native_closed);
+            }
+        }
+    }
+    let mut f = backend(&b);
+    f.fail = Some(5);
+    assert!(
+        serve_ordered(
+            &mut f,
+            &mut &stream(&b, b.sha256().unwrap())[..],
+            &mut Vec::new(),
+            &b,
+            &mut FrameBudget::new()
