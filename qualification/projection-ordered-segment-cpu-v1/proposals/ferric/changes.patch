+fn serve_ordered(backend: &mut impl Backend, r: &mut impl Read, w: &mut impl Write,
+    b: &selected::Bootstrap, incoming: &mut FrameBudget) -> io::Result<()> {
+    let result = b.sha256().and_then(|profile| serve_profile(backend, r, w, &b.decode, incoming, profile));
+    if result.is_err() { backend.failed(); }
+    result
