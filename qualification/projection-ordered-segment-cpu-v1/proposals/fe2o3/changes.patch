+fn region(id: u64, bytes: usize) -> profile::OwnedRegion {
+    profile::OwnedRegion { buffer: id, base: id * 0x1000_0000,
+        requested: bytes, backing: bytes.div_ceil(PAGE_BYTES) * PAGE_BYTES }
+}
+
+fn regions() -> [[profile::OwnedRegion; 11]; 2] {
+    core::array::from_fn(|rank| core::array::from_fn(|index|
+        region((rank * 11 + index + 1) as u64, profile::EXTENTS[index])))
+}
+
+fn reads() -> ([profile::OwnedRegion; 2], [profile::OwnedRegion; 2]) {
+    ([region(30, 16_384), region(31, 16_384)], [region(32, 8192), region(33, 8192)])
+}
