+    )?;
+    let timeline = recorder
+        .take()
+        .ok_or("host timing recorder absent")?
+        .finish()?;
+    let currentness_policy = super::shared_full::validate_file(&observation)?;
+    let host_timing = finish_timing(&observation, timeline)?;
+    Ok(SharedFullTimedObservation {
+        schema: SHARED_WRAPPER_SCHEMA,
+        observation,
+        currentness_policy,
+        host_timing,
+    })
