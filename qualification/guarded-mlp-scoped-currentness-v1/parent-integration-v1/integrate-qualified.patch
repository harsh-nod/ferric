-            io_error(M1EngineeringAggregateArtifactFileV1::RootDirectory, source)
-        })?;
-        match entry.file_name().to_bytes() {
-            b"." | b".." => {}
-            name if name == M1_ENGINEERING_AGGREGATE_MANIFEST_FILENAME_V1.as_bytes() => {
-                if manifest {
