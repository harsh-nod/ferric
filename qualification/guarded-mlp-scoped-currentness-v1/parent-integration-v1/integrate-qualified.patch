+        Counts {
+            ordinary_layers: 72,
+            scoped_layers: 1368,
+            scoped_layers_by_forward: (0..40).map(|p| if p < 2 { 0 } else { 36 }).collect(),
+            full_discoveries: 2736,
+            local_checkpoints: 5 * 1368,
