+const SCOPED_WRAPPER_SCHEMA: &str = "FerricReadiness40Position5ScopedWarmTimedObservationV1";
+const FILE_BYTES: u64 = 64 << 10;
+const SUMMARY_BYTES: u64 = 128 << 10;
