+/// Closed warm-only layer call. No capture, observer or extra hidden reread.
+/// # Safety
+/// `execute`'s authenticated roles and mixed-bank obligations apply. Only the
+/// explicit scoped profile may call this after both banks' ordinary first use.
+pub(crate) unsafe fn execute_warm_scoped(
+    group: &mut Group,
+    roster: &mut Roster,
+    prefix: &PrefixKernels,
+    mlp: &LoadedKernels,
+    images: &Loaded,
+    roots: &LayerBindings,
+    down: [Buffer; 2],
+    layer: usize,
+    timeout_ms: u32,
+) -> Result<crate::state_roster::guarded_mlp_decode_v1::WarmCompletion> {
+    struct Preparation<'a> {
+        roster: &'a mut Roster,
+        committed: bool,
+    }
+    impl Drop for Preparation<'_> {
+        fn drop(&mut self) {
+            if !self.committed {
+                self.roster.poison();
+            }
+        }
+    }
+    let mut preparation = Preparation {
+        roster,
+        committed: false,
+    };
+    if layer >= 36 || !(1..=10_000).contains(&timeout_ms) {
+        return Err("scoped warm layer/deadline".into());
+    }
+    let mlp_inputs = inputs(images, mlp, roots, down)?;
+    for rank in 0..2 {
+        if prefix.kernels[rank].rank() != rank {
+            return Err("scoped warm prefix kernel rank".into());
+        }
+    }
+    let prefix_inputs =
+        core::array::from_fn(
+            |rank| fe2o3_kfd::Gfx950EngineeringPeerScopedPrefixInputsV1 {
+                kernel: &prefix.kernels[rank],
+                object_sha256: prefix.sha256,
+                roots: roots.prefix[rank],
+                timeout_ms,
+            },
+        );
+    // SAFETY: exact model/image roles were checked above; Roster supplies the
+    // genuine same-slot owners and warm generation, not caller-made proofs.
+    let completion = unsafe {
+        preparation
+            .roster
+            .dispatch_warm_scoped(group, layer, prefix_inputs, mlp_inputs, timeout_ms)
+    }?;
+    preparation.committed = true;
+    Ok(completion)
