+    /// warm-only; the first two forwards use the unchanged ordinary path.
+    pub(crate) unsafe fn dispatch_warm_scoped(
+        &mut self,
+        group: &mut Group,
+        layer: usize,
+        prefix_inputs: [PrefixInputs<'_>; 2],
+        mlp_inputs: Inputs<'_>,
