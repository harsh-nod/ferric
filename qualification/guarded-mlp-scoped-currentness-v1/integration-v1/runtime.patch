+    pub(in super::super) fn run(
+        &mut self,
+        group: &mut Gfx950EngineeringPeerGroupV1,
+        inputs: Inputs<'_>,
+        timeout_ms: u32,
+    ) -> Result<Completion> {
+        self.run_with_terminal_policy(group, inputs, timeout_ms, TerminalPolicy::Legacy)
+    }
