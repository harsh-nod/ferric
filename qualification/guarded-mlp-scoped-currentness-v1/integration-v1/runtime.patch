-fn mismatch(
-    node_id: u32,
-    field: &'static str,
-    kfd: impl ToString,
-    render: impl ToString,
-) -> TopologyError {
-    TopologyError::RenderCorrelationMismatch {
-        node_id,
-        field,
-        kfd: kfd.to_string(),
-        render: render.to_string(),
-    }
-}
