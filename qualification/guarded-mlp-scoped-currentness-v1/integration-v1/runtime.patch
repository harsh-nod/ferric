+    fn map(&mut self, peers: &[u32]) -> KernelOutcome<u32> {
+        let context = &mut self.contexts[self.owner];
+        let handle = context.buffers[&self.local_id].handle;
+        context.backend.map_gpu_ids(handle, peers, 0)
