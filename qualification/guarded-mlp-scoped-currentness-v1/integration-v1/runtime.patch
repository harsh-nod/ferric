+fn after<B: CheckpointBackend>(
+    backend: &mut B,
+    counts: &mut ScopedCountsV1,
+    until: Instant,
+) -> Result<(), DeviceBindingError> {
+    for rank in 0..backend.participants() {
+        deadline(backend, until)?;
+        increment(&mut counts.after_calls)?;
+        backend.after(rank)?;
+        deadline(backend, until)?;
+    }
+    Ok(())
