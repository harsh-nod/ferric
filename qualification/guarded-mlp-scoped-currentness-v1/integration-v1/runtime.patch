-            crate::currentness::ResetEventFence::subscribe(&self.opened.fd, gpu_id)?;
-        if crate::linux::observe_drm_identity(&render.fd)? != render.drm {
-            return Err(DeviceBindingError::ObservableCurrentnessChanged(
