+trait PeerTransactionBackend {
+    fn check(&mut self) -> Result<()>;
+    fn map(&mut self, peers: &[u32]) -> KernelOutcome<u32>;
+    fn unmap(&mut self, peers: &[u32]) -> KernelOutcome<u32>;
+    fn release_owner(&mut self) -> Result<()>;
