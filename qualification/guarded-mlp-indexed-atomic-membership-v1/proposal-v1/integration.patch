+#[test]
+fn indexed_atomic_membership_real_inventory_keeps_statement_binding() {
+    let (types, function) = indexed_atomic_fixture_v1(true, false);
+    let (checks, allocations) = indexed_atomic_inventory_fixture_v1(&types, &function);
+    let inventory =
+        authenticated_atomic_allocations_v1(&types, &function, &checks, &allocations).unwrap();
+    assert_eq!(inventory.indexed_uses.len(), 2);
+    assert!(
+        inventory
+            .indexed_locals
+            .windows(2)
+            .all(|pair| pair[0].index() < pair[1].index())
+    );
+    for query in (0..function.locals().len() as u32).chain(std::iter::once(u32::MAX)) {
+        indexed_atomic_membership_query_for_test_v1(&inventory, query);
+    }
+    assert!(
+        inventory
+            .contains_local(SemanticLocalIdV1::from_index(7))
+            .unwrap()
+    );
+    let usage = &inventory.indexed_uses[0];
+    inventory
+        .validate_statement(
+            usage.block,
+            usage.statement,
+            &function.blocks()[usage.block].statements()[usage.statement],
+        )
+        .unwrap();
+    assert!(
+        inventory
+            .validate_statement(
+                usage.block,
+                usage.statement,
+                &statement(SemanticStatementKindV1::Nop),
+            )
+            .is_err()
+    );
+}
