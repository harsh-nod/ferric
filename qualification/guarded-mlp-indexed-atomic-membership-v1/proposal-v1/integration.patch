+#[test]
+fn indexed_atomic_membership_bounds_repeated_measured_size_queries() {
+    let ids = (0_u32..1656).map(|id| id * 2).collect::<Vec<_>>();
+    let inventory = indexed_atomic_membership_fixture_v1(&ids);
+    assert_eq!(indexed_atomic_membership_bound_for_test_v1(ids.len()), 11);
+    for query in 0..4096 {
+        indexed_atomic_membership_query_for_test_v1(&inventory, query);
+    }
+    assert_eq!(inventory.work.get(), 45056);
+    assert!(1656 * 4096 > MAX_PROJECTED_LOOP_GRAPH_WORK_V1);
+    assert_eq!(inventory.indexed_locals.len(), 1656);
+    assert!(inventory.indexed_uses.is_empty());
+    assert!(inventory.indexed_borrows.is_empty());
+    assert!(inventory.coherent.is_empty());
+    assert!(inventory.atomic_only_roots.is_empty());
+}
+
+#[test]
+fn indexed_atomic_membership_keeps_independent_inventories() {
+    let first = indexed_atomic_membership_fixture_v1(&[0, 2, 4]);
+    let second = indexed_atomic_membership_fixture_v1(&[1, 3, 5, u32::MAX]);
+    let cloned = first.clone();
+    indexed_atomic_membership_query_for_test_v1(&first, 2);
+    assert_eq!(first.work.get(), 2);
+    assert_eq!(second.work.get(), 0);
+    assert_eq!(cloned.work.get(), 0);
+    for query in [0, 1, 2, 5, u32::MAX] {
+        indexed_atomic_membership_query_for_test_v1(&second, query);
+        indexed_atomic_membership_query_for_test_v1(&cloned, query);
+    }
+    assert_eq!(first.work.get(), 2);
+    assert_eq!(second.work.get(), 15);
+    assert_eq!(cloned.work.get(), 10);
+}
