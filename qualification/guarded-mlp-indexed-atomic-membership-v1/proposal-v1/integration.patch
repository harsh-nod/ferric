+// Private inventory fixtures test lookup semantics, not kernel source authority.
+fn indexed_atomic_membership_fixture_v1(ids: &[u32]) -> AuthenticatedAtomicAllocationsV1 {
+    assert!(ids.windows(2).all(|pair| pair[0] <= pair[1]));
+    AuthenticatedAtomicAllocationsV1 {
+        indexed_locals: ids
+            .iter()
+            .copied()
+            .map(SemanticLocalIdV1::from_index)
+            .collect(),
+        ..Default::default()
+    }
+}
+
+fn indexed_atomic_membership_bound_for_test_v1(mut len: usize) -> usize {
+    let mut comparisons = 0;
+    while len != 0 {
+        comparisons += 1;
+        len /= 2;
+    }
+    comparisons
+}
+
+fn indexed_atomic_membership_query_for_test_v1(
+    inventory: &AuthenticatedAtomicAllocationsV1,
+    query: u32,
+) {
+    let local = SemanticLocalIdV1::from_index(query);
+    let expected = inventory.indexed_locals.contains(&local);
+    let before = inventory.work.get();
+    assert_eq!(inventory.contains_local(local).unwrap(), expected);
+    assert_eq!(
+        inventory.work.get() - before,
+        indexed_atomic_membership_bound_for_test_v1(inventory.indexed_locals.len())
+    );
+}
+
+#[test]
+fn indexed_atomic_membership_matches_all_small_sorted_sets() {
+    let mut queries = 0;
+    for mask in 0_u32..256 {
+        let ids = (0_u32..8)
+            .filter(|bit| mask & (1 << bit) != 0)
+            .map(|bit| bit * 2)
+            .collect::<Vec<_>>();
+        let inventory = indexed_atomic_membership_fixture_v1(&ids);
+        for query in (0_u32..=16).chain(std::iter::once(u32::MAX)) {
+            indexed_atomic_membership_query_for_test_v1(&inventory, query);
+            queries += 1;
+        }
+        assert_eq!(
+            inventory.work.get(),
+            18 * indexed_atomic_membership_bound_for_test_v1(ids.len())
+        );
+    }
+    assert_eq!(queries, 4608);
+}
+
+#[test]
+fn indexed_atomic_membership_handles_boundary_lengths() {
+    for len in [
+        0, 1, 2, 3, 4, 7, 8, 15, 16, 31, 32, 63, 64, 127, 128, 1023, 1024, 1656,
+        2047, 2048, 65536, MAX_PROJECTED_CAPABILITY_STATE_ENTRIES_V1,
+    ] {
+        let ids = (0..len).map(|index| (index * 2) as u32).collect::<Vec<_>>();
+        let inventory = indexed_atomic_membership_fixture_v1(&ids);
+        for query in [
+            0,
+            1,
+            len as u32,
+            (len * 2).saturating_sub(2) as u32,
+            (len * 2).saturating_sub(1) as u32,
+            (len * 2) as u32,
+            u32::MAX,
+        ] {
+            indexed_atomic_membership_query_for_test_v1(&inventory, query);
+        }
+        assert_eq!(
+            inventory.work.get(),
+            7 * indexed_atomic_membership_bound_for_test_v1(len)
+        );
+        assert_eq!(inventory.indexed_locals.len(), len);
+    }
+}
+
+#[test]
+fn indexed_atomic_membership_preserves_duplicate_and_extreme_ids() {
+    for ids in [
+        vec![0],
+        vec![u32::MAX],
+        vec![0, 0, 0],
+        vec![0, 0, 1, 1, u32::MAX - 1, u32::MAX, u32::MAX],
+        vec![u32::MAX - 2, u32::MAX - 1, u32::MAX],
+    ] {
+        let inventory = indexed_atomic_membership_fixture_v1(&ids);
+        for query in [0, 1, 2, u32::MAX / 2, u32::MAX - 2, u32::MAX - 1, u32::MAX] {
+            indexed_atomic_membership_query_for_test_v1(&inventory, query);
+        }
+        assert_eq!(
+            inventory
+                .indexed_locals
+                .iter()
+                .map(|local| local.index())
+                .collect::<Vec<_>>(),
+            ids
+        );
+    }
+}
+
+#[test]
+fn indexed_atomic_membership_charges_exact_bound_before_query() {
+    for ids in [vec![0], vec![0, 2, 4], (0..1656).map(|id| id * 2).collect()] {
+        let inventory = indexed_atomic_membership_fixture_v1(&ids);
+        let amount = indexed_atomic_membership_bound_for_test_v1(ids.len());
+        for query in [0, 1, u32::MAX] {
+            inventory.work.set(MAX_PROJECTED_LOOP_GRAPH_WORK_V1 - amount);
+            indexed_atomic_membership_query_for_test_v1(&inventory, query);
+            assert_eq!(inventory.work.get(), MAX_PROJECTED_LOOP_GRAPH_WORK_V1);
+            let error = inventory
+                .contains_local(SemanticLocalIdV1::from_index(query))
+                .unwrap_err();
+            assert!(matches!(
+                error,
+                ProductionRankedProjectionErrorV1::GraphWorkLimit(ref diagnostic)
+                    if diagnostic.reason == GraphWorkFailureV1::AboveLimit
+                        && diagnostic.before == MAX_PROJECTED_LOOP_GRAPH_WORK_V1
+                        && diagnostic.amount == amount
+                        && diagnostic.sum == Some(MAX_PROJECTED_LOOP_GRAPH_WORK_V1 + amount)
+            ));
+            assert_eq!(inventory.work.get(), MAX_PROJECTED_LOOP_GRAPH_WORK_V1);
+
+            let before = MAX_PROJECTED_LOOP_GRAPH_WORK_V1 - amount + 1;
+            inventory.work.set(before);
+            assert!(
+                inventory
+                    .contains_local(SemanticLocalIdV1::from_index(query))
+                    .is_err()
+            );
+            assert_eq!(inventory.work.get(), before);
+        }
+    }
+    let empty = indexed_atomic_membership_fixture_v1(&[]);
+    empty.work.set(MAX_PROJECTED_LOOP_GRAPH_WORK_V1);
+    assert!(
+        !empty
+            .contains_local(SemanticLocalIdV1::from_index(0))
+            .unwrap()
+    );
+    assert_eq!(empty.work.get(), MAX_PROJECTED_LOOP_GRAPH_WORK_V1);
+}
+
+#[test]
+fn indexed_atomic_membership_failed_charges_do_not_commit_work() {
+    for (ids, reason, amount, sum) in [
+        (vec![0], GraphWorkFailureV1::Overflow, 1, None),
+        (vec![0, 2, 4], GraphWorkFailureV1::Overflow, 2, None),
+        (vec![], GraphWorkFailureV1::AboveLimit, 0, Some(usize::MAX)),
+    ] {
+        let inventory = indexed_atomic_membership_fixture_v1(&ids);
+        inventory.work.set(usize::MAX);
+        let error = inventory
+            .contains_local(SemanticLocalIdV1::from_index(0))
+            .unwrap_err();
+        assert!(matches!(
+            error,
+            ProductionRankedProjectionErrorV1::GraphWorkLimit(ref diagnostic)
+                if diagnostic.reason == reason
+                    && diagnostic.before == usize::MAX
+                    && diagnostic.amount == amount
+                    && diagnostic.sum == sum
+        ));
+        assert_eq!(inventory.work.get(), usize::MAX);
+        assert_eq!(inventory.indexed_locals.len(), ids.len());
+    }
+}
