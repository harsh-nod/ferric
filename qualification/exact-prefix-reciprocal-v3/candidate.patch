diff --git a/device/qwen3-tp-wave-rmsnorm-kernels-v15/tests/prefix_reciprocal_fraction_v1.py b/device/qwen3-tp-wave-rmsnorm-kernels-v15/tests/prefix_reciprocal_fraction_v1.py
