diff --git a/device/qwen3-tp-wave-rmsnorm-kernels-v15/src/prefix_reciprocal_numerics_v1.rs b/device/qwen3-tp-wave-rmsnorm-kernels-v15/src/prefix_reciprocal_numerics_v1.rs
