--- /dev/null
+++ b/device/qwen3-tp-wave-rmsnorm-kernels-v15/tests/prefix_reciprocal_fraction_v1.py
@@ -0,0 +1,77 @@
+"""Independent exact-rational nearest-neighbor vectors; no floating arithmetic.
+
+Default mode verifies the checked-in TSV. --write regenerates it. This checks
+the u64 Rust reference's exponent packing independently, not GPU execution.
+"""
+import argparse
+from fractions import Fraction
+from pathlib import Path
+
+LOW, HIGH = 0x3A800000, 0x5F800000
+FIXTURE = Path(__file__).with_name("fixtures") / "prefix_reciprocal_fraction_v1.tsv"
+
+
+def value(bits):
+    exponent, fraction = bits >> 23, bits & 0x7FFFFF
+    assert 0 <= bits < 0x7F800000
+    significand = fraction if exponent == 0 else (1 << 23) + fraction
+    shift = -149 if exponent == 0 else exponent - 150
+    return Fraction(significand << shift) if shift >= 0 else Fraction(significand, 1 << -shift)
+
+
+def nearest_reciprocal(bits):
+    assert LOW <= bits <= HIGH
+    target = 1 / value(bits)
+    low, high = 0, 0x7F7FFFFF
+    while low < high:
+        middle = (low + high + 1) // 2
+        if value(middle) <= target:
+            low = middle
+        else:
+            high = middle - 1
+    lower, upper = low, low + 1
+    lower_distance, upper_distance = target - value(lower), value(upper) - target
+    if lower_distance < upper_distance:
+        return lower
+    if upper_distance < lower_distance:
+        return upper
+    return lower if lower % 2 == 0 else upper
+
+
+def cases():
+    words = {LOW, HIGH}
+    mantissas = (0, 1, 2, 3, 0x2AAAAA, 0x3FFFFF, 0x400000, 0x555555, 0x7FFFFD, 0x7FFFFE, 0x7FFFFF)
+    for exponent in range(117, 192):
+        words.update((exponent << 23) | mantissa for mantissa in mantissas)
+    state = 0x31415926
+    for index in range(192):
+        state = (1664525 * state + 1013904223) & 0xFFFFFFFF
+        words.add(((117 + index % 74) << 23) | (state & 0x7FFFFF))
+    return sorted(word for word in words if LOW <= word <= HIGH)
+
+
+def rendered():
+    lines = ["# Positive normal denominator bits\tRN-even reciprocal bits"]
+    lines.extend(f"{word:08x}\t{nearest_reciprocal(word):08x}" for word in cases())
+    return "\n".join(lines) + "\n"
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--write", action="store_true")
+    args = parser.parse_args()
+    assert value(0x3F800000) == 1
+    assert value(0x3F7FFFFF) == 1 - Fraction(1, 1 << 24)
+    assert nearest_reciprocal(0x3F7FFFFF) == 0x3F800001
+    assert nearest_reciprocal(LOW) == 0x44800000
+    assert nearest_reciprocal(HIGH) == 0x1F800000
+    expected = rendered()
+    if args.write:
+        FIXTURE.parent.mkdir(parents=True, exist_ok=True)
+        FIXTURE.write_text(expected, encoding="ascii")
+    assert FIXTURE.read_text(encoding="ascii") == expected
+    print(f"PASS: {len(cases())} exact Fraction nearest-neighbor vectors; GPU execution not tested")
+
+
+if __name__ == "__main__":
+    main()
