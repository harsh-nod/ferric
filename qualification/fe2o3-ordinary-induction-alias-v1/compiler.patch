+    #[test]
+    fn ordinary_temporary_uses_the_existing_alias_work_budget() {
+        let types = assertion_proof_types();
+        let function = fixture(Form::Ordinary, SCALAR_TYPE, 24, 1, true);
+        let graph = projected_loop_cfg_graph_v1(&types, &function).unwrap();
+        let mut proofs = SemanticAssertProofsV1::new(&types, &function).unwrap();
+        let definitions = local_definition_counts(&function);
+        let sites = proofs.assignments.clone();
+        let topology = ProjectedNaturalLoopTopologyV1 {
+            preheader: 0,
+            preheader_control: ProjectedInductionPreheaderControlV1::Direct,
+            latch: 3,
+            loop_blocks: vec![1, 2, 3],
+        };
+        let mut exhausted = MAX_PROJECTED_CAPABILITY_DATAFLOW_WORK_V1;
+        assert!(matches!(
+            source_induction_update_v1(
+                &function,
+                &graph,
+                &mut proofs,
+                &topology,
+                SemanticLocalIdV1::from_index(1),
+                1,
+                &definitions,
+                &sites,
+                &mut exhausted,
+            ),
+            Err(ProductionRankedProjectionErrorV1::Unsupported(
+                "uniform induction alias analysis exceeds its work limit",
+            )),
+        ));
+        let mut exact = MAX_PROJECTED_CAPABILITY_DATAFLOW_WORK_V1 - 2;
+        assert!(
+            source_induction_update_v1(
+                &function,
+                &graph,
+                &mut proofs,
+                &topology,
+                SemanticLocalIdV1::from_index(1),
+                1,
+                &definitions,
+                &sites,
+                &mut exact,
+            )
+            .unwrap()
+            .is_some()
+        );
+        assert_eq!(exact, MAX_PROJECTED_CAPABILITY_DATAFLOW_WORK_V1);
+    }
