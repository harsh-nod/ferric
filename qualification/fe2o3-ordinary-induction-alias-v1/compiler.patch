+mod ordinary_induction_alias_v1_tests {
+    use super::*;
+
+    #[derive(Clone, Copy)]
+    enum Form {
+        Ordinary,
+        CrossBlock,
+        Gap,
+        AfterUse,
+        CopyChain,
+        MultipleDefinitions,
+        Escaped,
+        WrongLocalType,
+        WrongProducerType,
+        Subtract,
+        Unchecked,
+        CheckedCopy,
+    }
+
+    fn place(index: u32, ty: SemanticTypeIdV1) -> SemanticPlaceV1 {
+        SemanticPlaceV1::new(SemanticLocalIdV1::from_index(index), vec![], ty).unwrap()
+    }
+
+    fn copy(index: u32, ty: SemanticTypeIdV1) -> SemanticOperandV1 {
+        SemanticOperandV1::Copy(place(index, ty))
+    }
+
+    fn assign(
+        index: u32,
+        ty: SemanticTypeIdV1,
+        value: SemanticRvalueKindV1,
+    ) -> SemanticStatementV1 {
+        statement(SemanticStatementKindV1::Assign(SemanticAssignmentV1::new(
+            place(index, ty),
+            SemanticRvalueV1::new(ty, value),
+        )))
+    }
+
+    fn fixture(
+        form: Form,
+        ty: SemanticTypeIdV1,
+        bound: u64,
+        step: u64,
+        move_result: bool,
+    ) -> SemanticFunctionDeclV1 {
+        let size = if ty == SCALAR_TYPE { 4 } else { 8 };
+        let constant = |value| typed_constant(ty, u128::from(value), size);
+        let add = |destination, operation| {
+            assign(
+                destination,
+                ty,
+                SemanticRvalueKindV1::Binary {
+                    operation,
+                    left: copy(1, ty),
+                    right: constant(step),
+                },
+            )
+        };
+        let result = if move_result {
+            SemanticOperandV1::Move(place(3, ty))
+        } else {
+            copy(3, ty)
+        };
+        let latch_copy = assign(1, ty, SemanticRvalueKindV1::Use(result));
+        let mut producer = add(3, SemanticBinaryOpV1::Add);
+        let mut body = vec![];
+        let mut latch = vec![producer.clone(), latch_copy.clone()];
+        let mut body_end = SemanticTerminatorKindV1::Goto(cfg_edge(SemanticEdgeRoleV1::Goto, 3));
+        match form {
+            Form::Ordinary | Form::WrongLocalType => {}
+            Form::CrossBlock => {
+                body.push(producer);
+                latch.remove(0);
+            }
+            Form::Gap => latch.insert(1, statement(SemanticStatementKindV1::Nop)),
+            Form::AfterUse => latch.reverse(),
+            Form::CopyChain => {
+                latch = vec![
+                    add(4, SemanticBinaryOpV1::Add),
+                    assign(3, ty, SemanticRvalueKindV1::Use(copy(4, ty))),
+                    latch_copy,
+                ];
+            }
+            Form::MultipleDefinitions => latch.insert(0, producer),
+            Form::Escaped => {
+                let pointer_type = if ty == SCALAR_TYPE {
+                    POINTER_TYPE
+                } else {
+                    U64_POINTER_TYPE
+                };
+                body.push(assign(
+                    5,
+                    pointer_type,
+                    SemanticRvalueKindV1::AddressOf {
+                        mutability: SemanticMutabilityV1::Mutable,
+                        place: place(3, ty),
+                    },
+                ));
+            }
+            Form::WrongProducerType => {
+                producer = statement(SemanticStatementKindV1::Assign(SemanticAssignmentV1::new(
+                    place(3, ty),
+                    SemanticRvalueV1::new(
+                        BOOL_TYPE,
+                        SemanticRvalueKindV1::Binary {
+                            operation: SemanticBinaryOpV1::Add,
+                            left: copy(1, ty),
+                            right: constant(step),
+                        },
+                    ),
+                )));
+                latch[0] = producer;
+            }
+            Form::Subtract => latch[0] = add(3, SemanticBinaryOpV1::Subtract),
+            Form::Unchecked => {
+                latch[0] = assign(
+                    3,
+                    ty,
+                    SemanticRvalueKindV1::UncheckedBinary(SemanticUncheckedBinaryRvalueV1::new(
+                        SemanticUncheckedBinaryOpV1::Add,
+                        copy(1, ty),
+                        constant(step),
+                    )),
+                );
+            }
+            Form::CheckedCopy => {
+                assert_eq!(ty, U64_TYPE);
+                let field = |index, field_type| {
+                    SemanticOperandV1::Copy(
+                        SemanticPlaceV1::new(
+                            SemanticLocalIdV1::from_index(6),
+                            vec![
+                                SemanticProjectionV1::new(
+                                    SemanticProjectionKindV1::Field(index),
+                                    field_type,
+                                )
+                                .unwrap(),
+                            ],
+                            field_type,
+                        )
+                        .unwrap(),
+                    )
+                };
+                body.push(assign(
+                    6,
+                    CHECKED_U64_TYPE,
+                    SemanticRvalueKindV1::CheckedBinary(SemanticCheckedBinaryRvalueV1::new(
+                        SemanticCheckedBinaryOpV1::Add,
+                        copy(1, ty),
+                        constant(step),
+                    )),
+                ));
+                body_end = SemanticTerminatorKindV1::Assert {
+                    condition: field(1, BOOL_TYPE),
+                    expected: false,
+                    message: SemanticAssertMessageV1::Overflow {
+                        operation: SemanticBinaryOpV1::Add,
+                        left: copy(1, ty),
+                        right: constant(step),
+                    },
+                    target: cfg_edge(SemanticEdgeRoleV1::AssertSuccess, 3),
+                    unwind: SemanticUnwindActionV1::Unreachable,
+                };
+                latch[0] = assign(3, ty, SemanticRvalueKindV1::Use(field(0, ty)));
+            }
+        }
+        projection_function_with_locals(
+            vec![
+                block(
+                    220,
+                    vec![assign(1, ty, SemanticRvalueKindV1::Use(constant(0)))],
+                    SemanticTerminatorKindV1::Goto(cfg_edge(SemanticEdgeRoleV1::Goto, 1)),
+                ),
+                block(
+                    221,
+                    vec![assign(
+                        2,
+                        BOOL_TYPE,
+                        SemanticRvalueKindV1::Binary {
+                            operation: SemanticBinaryOpV1::LessThan,
+                            left: copy(1, ty),
+                            right: constant(bound),
+                        },
+                    )],
+                    SemanticTerminatorKindV1::SwitchInt {
+                        discriminant: copy(2, BOOL_TYPE),
+                        targets: SemanticSwitchTargetsV1::new(
+                            vec![SemanticSwitchTargetV1::new(
+                                0,
+                                cfg_edge(SemanticEdgeRoleV1::SwitchValue, 4),
+                            )],
+                            cfg_edge(SemanticEdgeRoleV1::SwitchOtherwise, 2),
+                        )
+                        .unwrap(),
+                    },
+                ),
+                block(222, body, body_end),
+                block(
+                    223,
+                    latch,
+                    SemanticTerminatorKindV1::Goto(cfg_edge(SemanticEdgeRoleV1::Goto, 1)),
+                ),
+                block(224, vec![], SemanticTerminatorKindV1::Return),
+            ],
+            vec![
+                local(220, SCALAR_TYPE, SemanticLocalRoleV1::Return),
+                local(221, ty, SemanticLocalRoleV1::Temporary),
+                local(222, BOOL_TYPE, SemanticLocalRoleV1::Temporary),
+                local(
+                    223,
+                    if matches!(form, Form::WrongLocalType) {
+                        BOOL_TYPE
+                    } else {
+                        ty
+                    },
+                    SemanticLocalRoleV1::Temporary,
+                ),
+                local(224, ty, SemanticLocalRoleV1::Temporary),
+                local(
+                    225,
+                    if ty == SCALAR_TYPE {
+                        POINTER_TYPE
+                    } else {
+                        U64_POINTER_TYPE
+                    },
+                    SemanticLocalRoleV1::Temporary,
+                ),
+                local(226, CHECKED_U64_TYPE, SemanticLocalRoleV1::Temporary),
+            ],
+        )
+    }
+
+    fn update(
+        function: &SemanticFunctionDeclV1,
+    ) -> Result<Option<ProjectedSourceInductionUpdateV1>, ProductionRankedProjectionErrorV1> {
+        let types = assertion_proof_types();
+        let graph = projected_loop_cfg_graph_v1(&types, function)?;
+        let mut proofs = SemanticAssertProofsV1::new(&types, function)?;
+        let definitions = local_definition_counts(function);
+        let sites = proofs.assignments.clone();
+        let topology = ProjectedNaturalLoopTopologyV1 {
+            preheader: 0,
+            preheader_control: ProjectedInductionPreheaderControlV1::Direct,
+            latch: 3,
+            loop_blocks: vec![1, 2, 3],
+        };
+        let latch_statement = function.blocks()[3]
+            .statements()
+            .iter()
+            .position(|statement| {
+                matches!(statement.kind(), SemanticStatementKindV1::Assign(value)
+                if value.destination().local() == SemanticLocalIdV1::from_index(1))
+            })
+            .unwrap();
+        source_induction_update_v1(
+            function,
+            &graph,
+            &mut proofs,
+            &topology,
+            SemanticLocalIdV1::from_index(1),
+            latch_statement,
+            &definitions,
+            &sites,
+            &mut 0,
+        )
+        .map(|update| update.map(|(kind, _)| kind))
+    }
+
+    #[test]
+    fn ordinary_temporary_copy_and_move_replay_and_build_the_ranked_loop() {
+        let types = assertion_proof_types();
+        for ty in [SCALAR_TYPE, U64_TYPE] {
+            for move_result in [false, true] {
+                let function = fixture(Form::Ordinary, ty, 24, 1, move_result);
+                let (inductions, operations, next_argument) =
+                    project_test_inductions_with_types(&types, &function).unwrap();
+                assert_eq!(inductions.len(), 1);
+                assert_eq!(
+                    inductions[0].source_progress.update,
+                    ProjectedSourceInductionUpdateV1::OrdinaryTemporary {
+                        producer_block: 3,
+                        producer_statement: 0,
+                        result_local: SemanticLocalIdV1::from_index(3),
+                    }
+                );
+                assert_eq!(
+                    inductions[0]
+                        .source_progress
+                        .update
+                        .proved_overflow_assert_block(),
+                    None
+                );
+                assert_eq!(inductions[0].source_progress.step_value, 1);
+                let (blocks, _, _) = build_ranked_cfg(
+                    &types,
+                    &function,
+                    &[],
+                    &vec![None; function.locals().len()],
+                    &vec![None; function.blocks().len()],
+                    &inductions,
+                    operations,
+                    (0..function.blocks().len())
+                        .map(|_| ProjectedSemanticBlockV1 { items: vec![] })
+                        .collect(),
+                )
+                .unwrap();
+                ProductionRankedKernelV1::new("ordinary_temporary_loop", next_argument, blocks)
+                    .unwrap();
+            }
+        }
+    }
+
+    #[test]
+    fn ordinary_temporary_refuses_cross_block_nonadjacent_and_after_use_producers() {
+        let types = assertion_proof_types();
+        for form in [Form::CrossBlock, Form::Gap] {
+            assert_incomplete(
+                project_test_inductions_with_types(
+                    &types,
+                    &fixture(form, SCALAR_TYPE, 24, 1, true),
+                ),
+                "an ordinary induction temporary is not adjacent in its latch block",
+            );
+        }
+        assert_incomplete(
+            project_test_inductions_with_types(
+                &types,
+                &fixture(Form::AfterUse, SCALAR_TYPE, 24, 1, true),
+            ),
+            "a uniform induction operand has a cyclic copy alias",
+        );
+    }
+
+    #[test]
+    fn ordinary_temporary_refuses_chains_redefinitions_and_escaped_values() {
+        let types = assertion_proof_types();
+        for (form, message) in [
+            (
+                Form::CopyChain,
+                "an ordinary induction temporary cannot be a copy alias chain",
+            ),
+            (
+                Form::MultipleDefinitions,
+                "an ordinary induction temporary changed type or definition custody",
+            ),
+            (
+                Form::Escaped,
+                "a uniform induction alias has address-escaped value semantics",
+            ),
+        ] {
+            assert_incomplete(
+                project_test_inductions_with_types(
+                    &types,
+                    &fixture(form, SCALAR_TYPE, 24, 1, true),
+                ),
+                message,
+            );
+        }
+    }
+
+    #[test]
+    fn ordinary_temporary_refuses_local_and_producer_type_substitution() {
+        // These deliberately malformed typed records exercise the candidate
+        // reader directly; they are not claimed to be admitted semantic MIR.
+        for (form, message) in [
+            (
+                Form::WrongLocalType,
+                "an ordinary induction temporary changed type or definition custody",
+            ),
+            (
+                Form::WrongProducerType,
+                "an ordinary induction temporary producer changed its exact destination",
+            ),
+        ] {
+            assert_incomplete(update(&fixture(form, SCALAR_TYPE, 24, 1, true)), message);
+        }
+    }
+
+    #[test]
+    fn ordinary_temporary_does_not_admit_other_operators_or_checked_and_unchecked_copies() {
+        let types = assertion_proof_types();
+        for form in [Form::Subtract, Form::Unchecked, Form::CheckedCopy] {
+            assert_incomplete(
+                project_test_inductions_with_types(&types, &fixture(form, U64_TYPE, 24, 1, true)),
+                "an ordinary induction temporary is not defined by ordinary Add",
+            );
+        }
+        // The original direct checked-latch route remains available.
+        let checked = widened_u64_induction_function_with_latch(1, WidenedLatchKind::Checked);
+        let (inductions, _, _) = project_test_inductions_with_types(&types, &checked).unwrap();
+        assert!(matches!(
+            inductions[0].source_progress.update,
+            ProjectedSourceInductionUpdateV1::Checked { .. }
+        ));
+    }
+
+    #[test]
+    fn ordinary_temporary_still_requires_a_positive_step_and_exact_unsigned_no_overflow() {
+        let types = assertion_proof_types();
+        assert_incomplete(
+            project_test_inductions_with_types(
+                &types,
+                &fixture(Form::Ordinary, SCALAR_TYPE, 24, 0, true),
+            ),
+            "a uniform induction whose positive step is not statically established",
+        );
+        for (ty, maximum) in [(SCALAR_TYPE, u64::from(u32::MAX)), (U64_TYPE, u64::MAX)] {
+            assert!(
+                project_test_inductions_with_types(
+                    &types,
+                    &fixture(Form::Ordinary, ty, maximum, 1, true)
+                )
+                .is_ok()
+            );
+            assert_incomplete(
+                project_test_inductions_with_types(
+                    &types,
+                    &fixture(Form::Ordinary, ty, maximum, 2, true),
+                ),
+                "a compiler-derived source induction update may overflow its exact unsigned type",
+            );
+        }
+    }
+
+    #[test]
+    fn ordinary_temporary_replay_binds_producer_site_local_and_update_kind() {
+        let types = assertion_proof_types();
+        let function = fixture(Form::Ordinary, SCALAR_TYPE, 24, 1, true);
+        let constants = constant_locals(&function).unwrap();
+        let origins = local_stable_argument_origins(&types, &function).unwrap();
+        let definitions = local_definition_counts(&function);
+        let mut arguments = vec![None; function.locals().len()];
+        let mut next_argument = 1;
+        let mut operations = vec![];
+        let mut next_value = 0;
+        let inductions = project_uniform_inductions_v1(
+            &[],
+            &types,
+            &function,
+            &constants,
+            &origins,
+            &definitions,
+            &mut arguments,
+            &mut next_argument,
+            &mut operations,
+            &mut next_value,
+        )
+        .unwrap();
+        for mutation in 0..4 {
+            let mut hostile = inductions.clone();
+            hostile[0].source_progress.update = match mutation {
+                0 => ProjectedSourceInductionUpdateV1::OrdinaryTemporary {
+                    producer_block: 2,
+                    producer_statement: 0,
+                    result_local: SemanticLocalIdV1::from_index(3),
+                },
+                1 => ProjectedSourceInductionUpdateV1::OrdinaryTemporary {
+                    producer_block: 3,
+                    producer_statement: 1,
+                    result_local: SemanticLocalIdV1::from_index(3),
+                },
+                2 => ProjectedSourceInductionUpdateV1::OrdinaryTemporary {
+                    producer_block: 3,
+                    producer_statement: 0,
+                    result_local: SemanticLocalIdV1::from_index(4),
+                },
+                _ => ProjectedSourceInductionUpdateV1::Ordinary,
+            };
+            let mut hostile_operations = operations.clone();
+            let mut hostile_next_value = next_value;
+            assert_incomplete(
+                reconcile_source_progress_and_emit_unsigned_casts_v1(
+                    &types,
+                    &function,
+                    &constants,
+                    &origins,
+                    &definitions,
+                    &arguments,
+                    &mut hostile,
+                    &mut hostile_operations,
+                    &mut hostile_next_value,
+                ),
+                "a compiler-derived source induction latch changed type, step, or overflow semantics",
+            );
+        }
+    }
